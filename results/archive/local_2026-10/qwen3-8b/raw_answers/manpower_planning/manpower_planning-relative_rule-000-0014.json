{
 "version": "0.1",
 "base_model": "manpower_planning",
 "rules": [
  {
   "name": "redundant_year2_at_most_25_of_year1",
   "measure": "redundant",
   "scope": {
    "year": 2
   },
   "sense": "<=",
   "relative_to": {
    "measure": "redundant",
    "scope": {
     "year": 1
    }
   },
   "factor": 0.25
  }
 ],
 "note": "A rule that limits the sum of redundant workers in year 2 to at most 25% of the sum in year 1."
}