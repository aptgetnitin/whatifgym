{
 "version": "0.1",
 "base_model": "manpower_planning",
 "rules": [
  {
   "name": "short_time_year1_to_year3",
   "measure": "short_time",
   "scope": {
    "year": 1
   },
   "sense": "<=",
   "relative_to": {
    "measure": "short_time",
    "scope": {
     "year": 3
    }
   },
   "factor": 0.25
  }
 ],
 "note": "A rule that limits the short-time working in year 1 to 25% of that in year 3."
}