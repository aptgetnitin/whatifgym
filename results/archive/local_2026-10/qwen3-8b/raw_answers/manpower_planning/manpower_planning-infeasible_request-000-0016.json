    "from_skill": "unskilled",
    "to_skill": "semi_skilled"
   },
   "sense": "<=",
   "value": 1000
  }
 ],
 "note": "Set the max_per_year for unskilled to semi-skilled retraining in year 3 to 1000 and add a rule to ensure the retrain count does not exceed this limit."
