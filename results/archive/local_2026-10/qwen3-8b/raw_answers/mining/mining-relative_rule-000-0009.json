{
 "version": "0.1",
 "base_model": "mining",
 "rules": [
  {
   "name": "open_mine_years_limit",
   "measure": "open",
   "scope": {
    "year": "Year2"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "open",
    "scope": {
     "year": [
      "Year1",
      "Year2",
      "Year3",
      "Year4",
      "Year5"
     ]
    }
   },
   "factor": 0.15
  },
  {
   "name": "blend_year1_limit",
   "measure": "blend",
   "scope": {
    "year": "Year1"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "blend",
    "scope": {
     "year": "Year4"
    }
   },
   "factor": 0.8
  }
 ],
 "note": "Two relative limits are applied: one on the number of mine-years kept open in Year2 relative to the total, and one on the tons of blended ore sold in Year1 relative to Year4."
}