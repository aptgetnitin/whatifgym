{
 "version": "0.1",
 "base_model": "car_rental_2",
 "rules": [
  {
   "name": "undamaged_stock_monday_plymouth",
   "measure": "undamaged_stock",
   "scope": {
    "day": "Monday",
    "depot": "Plymouth"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "rentals",
    "scope": {
     "day": "Thursday",
     "depot": "Plymouth"
    }
   },
   "factor": 1.0
  }
 ],
 "note": "The rule ensures that the undamaged cars at Plymouth on Monday are at least equal to the number of cars rented out on Thursday at Plymouth."
}