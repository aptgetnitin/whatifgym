{
 "version": "0.1",
 "base_model": "car_rental_2",
 "data_changes": [
  {
   "op": "scale",
   "table": "rental_lengths",
   "column": "price_other_depot",
   "where": {
    "rental_days": [
     1,
     2,
     3
    ]
   },
   "factor": 1.1
  },
  {
   "op": "set",
   "table": "demand",
   "column": "demand",
   "where": {
    "day": "Saturday",
    "depot": "Manchester"
   },
   "value": 74
  }
 ],
 "note": "The price for returning to another depot is increased by 10% for all rental lengths, and the demand for Saturday at Manchester is set to 74."
}