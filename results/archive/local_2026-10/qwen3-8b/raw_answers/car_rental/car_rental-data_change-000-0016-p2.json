{
 "version": "0.1",
 "base_model": "car_rental",
 "data_changes": [
  {
   "op": "scale",
   "table": "transfer_costs",
   "column": "cost",
   "where": {
    "from_depot": "Glasgow",
    "to_depot": "Birmingham"
   },
   "factor": 0.5
  }
 ],
 "note": "The transfer cost between Glasgow and Birmingham is scaled down by 50%."
}