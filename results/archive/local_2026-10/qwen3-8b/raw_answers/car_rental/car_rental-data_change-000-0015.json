{
 "version": "0.1",
 "base_model": "car_rental",
 "data_changes": [
  {
   "op": "scale",
   "table": "rental_lengths",
   "column": "price_same_depot",
   "where": {
    "rental_days": 3
   },
   "factor": 1.3
  }
 ],
 "note": "The price for returning to the same depot for 3-day rentals is scaled up by 30%."
