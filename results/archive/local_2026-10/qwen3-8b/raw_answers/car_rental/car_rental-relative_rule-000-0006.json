{
 "version": "0.1",
 "base_model": "car_rental",
 "rules": [
  {
   "name": "birmingham_repairs_at_least_three_times_manchester",
   "measure": "repairs",
   "scope": {
    "depot": "Birmingham"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "repairs",
    "scope": {
     "depot": "Manchester"
    }
   },
   "factor": 3
  }
 ],
 "note": "The number of cars repaired at Birmingham is at least three times the number repaired at Manchester."
}