{
 "version": "0.1",
 "base_model": "farm_planning",
 "rules": [
  {
   "name": "heifer_calves_sold_year2_at_least_2_times_year4",
   "measure": "sell_heifers",
   "scope": {
    "year": "Year2"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "sell_heifers",
    "scope": {
     "year": "Year4"
    }
   },
   "factor": 2
  },
  {
   "name": "year1_sugar_beet_sold_at_most_10_percent_of_total",
   "measure": "sell_beet",
   "scope": {
    "year": "Year1"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "sell_beet",
    "scope": {
     "year": [
      "Year1",
      "Year2",
      "Year3",
      "Year4",
      "Year5"
     ]
    }
   },
   "factor": 0.1
  }
 ],
 "note": "Two relative limits: heifer calves sold in Year2 at least twice those sold in Year4; Year1's sugar beet sold at most 10% of total."
}