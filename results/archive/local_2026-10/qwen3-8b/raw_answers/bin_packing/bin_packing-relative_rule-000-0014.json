{
 "version": "0.1",
 "base_model": "bin_packing",
 "rules": [
  {
   "name": "bin0_at_least_30_percent",
   "measure": "y",
   "scope": {
    "bin": "bin0"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "y",
    "scope": {
     "bin": "*"
    }
   },
   "factor": 0.3
  },
  {
   "name": "bins_used_at_least_80_percent",
   "measure": "y",
   "scope": {
    "bin": "*"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "y",
    "scope": {
     "bin": "*"
    }
   },
   "factor": 0.8
  }
 ],
 "note": "Two relative limits on the number of bins used and the number of items packed into bin0."
}