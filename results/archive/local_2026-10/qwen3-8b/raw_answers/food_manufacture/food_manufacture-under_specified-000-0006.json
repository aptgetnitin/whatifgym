{"version": "0.1","base_model": "food_manufacture","data_changes": [{"op": "set","table": "purchase_prices","column": "price","where": {"month": "Jun","oil": "VEG1"},"value": 20},{"op": "scale","table": "purchase_prices","column": "price","where": {"month": "Mar","oil": "OIL1"},"factor": 0.9},{"op": "scale","table": "purchase_prices","column": "price","where": {"month": "Mar","oil": "OIL2"},"factor": 0.9},{"op": "scale","table": "purchase_prices","column": "price","where": {"month": "Mar","oil": "OIL3"},"factor": 0.9},{"op": "remove","table": "purchase_prices","where": {"month": "Feb","oil": "OIL2"}}],"rules": [{"name": "buy_cap","measure": "buy","scope": {"month": "Feb","oil": "OIL2"},"sense": "<=","value": 0}],"note": "A cap on the tons of oil bought is applied to OIL2 in February."}