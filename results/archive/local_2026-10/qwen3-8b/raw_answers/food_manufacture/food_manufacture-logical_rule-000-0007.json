{
 "version": "0.1",
 "base_model": "food_manufacture",
 "rules": [
  {
   "name": "produce_only_one_month",
   "measure": "produce",
   "scope": {
    "month": [
     "Feb",
     "Mar",
     "Jun",
     "Jan",
     "May"
    ]
   },
   "sense": "<=",
   "value": 1
  }
 ],
 "note": "Restrict production to only one month across the specified months."
}