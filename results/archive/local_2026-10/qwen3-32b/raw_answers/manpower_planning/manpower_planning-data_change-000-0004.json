{
  "version": "0.1",
  "base_model": "manpower_planning",
  "data_changes": [
    {
      "op": "scale",
      "table": "skills",
      "column": "current_strength",
      "where": {
        "skill": "skilled"
      },
      "factor": 0.75
    },
    {
      "op": "scale",
      "table": "costs",
      "column": "short_time_cost",
      "where": {
        "skill": ["unskilled", "semi_skilled", "skilled"]
      },
      "factor": 1.2
    }
  ],
  "note": "Adjusting the current_strength of skilled workers and increasing short_time_cost by 20% across all skill levels."
}