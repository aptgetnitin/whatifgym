{

 "version": "0.1",
 "base_model": "factory_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "max_sales",
   "column": "max_sales",
   "where": {
    "product": "Prod7",
    "month": [
     "Feb",
     "Mar",
     "Apr"
    ]
   },
   "factor": 0.7
  }
 ],
 "note": "A 30% market shrinkage for Prod7 in Feb-Mar-Apr requires scaling max_sales by 0.7 for those months."
}