{
  "version": "0.1",
  "base_model": "multiple_knapsack",
  "data_changes": [
    {
      "op": "scale",
      "table": "bins",
      "column": "capacity",
      "where": {
        "bin": [
          "bin0",
          "bin1",
          "bin2",
          "bin3",
          "bin4"
        ]
      },
      "factor": 0.75
    }
  ],
  "note": "Every bin's capacity is scaled down by 25% (factor 0.75) across all bins."
}