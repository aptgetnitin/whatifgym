{
  "version": "0.1",
  "base_model": "power_generation_hydro",
  "data_changes": [
    {
      "op": "set",
      "table": "thermal_types",
      "column": "min_output_mw",
      "where": {
        "type": [
          "Thermal0",
          "Thermal1",
          "Thermal2"
        ]
      },
      "value": 0
    }
  ],
  "note": "A minimum thermal output of 0 MW means no thermal units can run, which is a valid scenario for the model."
}