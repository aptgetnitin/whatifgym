{
  "version": "0.1",
  "base_model": "factory_planning",
  "rules": [
    {
      "name": "total_make_at_most_stock",
      "measure": "make",
      "scope": {
        "month": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ],
        "product": [
          "Prod1",
          "Prod2",
          "Prod3",
          "Prod4",
          "Prod5",
          "Prod6",
          "Prod7"
        ]
      },
      "sense": "<=",
      "value": 0.25
    }
  ],
  "note": "The rule sets a global upper bound on the total make across all products and months, relative to the total stock across all products and months."
  }