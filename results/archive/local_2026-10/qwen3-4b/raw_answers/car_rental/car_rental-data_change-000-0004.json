{
  "version": "0.1",
  "base_model": "car_rental",
  "data_changes": [
    {
      "op": "scale",
      "table": "transfer_costs",
      "column": "cost",
      "where": {
        "from_depot": "Manchester",
        "to_depot": "Glasgow"
      },
      "factor": 0.2
    },
    {
      "op": "scale",
      "table": "depots",
      "column": "repair_capacity",
      "where": {
        "depot": [
          "Glasgow",
          "Manchester",
          "Birmingham",
          "Plymouth"
        ]
      },
      "factor": 0.25
    }
  ]
}