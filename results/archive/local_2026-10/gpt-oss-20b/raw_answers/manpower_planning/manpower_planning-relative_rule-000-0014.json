{
  "version": "0.1",
  "base_model": "manpower_planning",
  "rules": [
    {
      "name": "redundant_year2_at_most_25_percent_of_year1",
      "measure": "redundant",
      "scope": { "year": 2 },
      "sense": "<=",
      "relative_to": {
        "measure": "redundant",
        "scope": { "year": 1 }
      },
      "factor": 0.25
    }
  ],
  "note": "Limit redundant workers in year 2 to at most 25% of those in year 1."
}