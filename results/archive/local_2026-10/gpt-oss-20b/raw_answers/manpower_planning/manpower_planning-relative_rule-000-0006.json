{
  "version": "0.1",
  "base_model": "manpower_planning",
  "rules": [
    {
      "measure": "redundant",
      "scope": {
        "year": 1
      },
      "sense": "<=",
      "relative_to": {
        "measure": "redundant",
        "scope": {
          "year": 2
        }
      },
      "factor": 1.5
    }
  ],
  "note": "Limit redundant workers in year 1 to at most 1.5 times those in year 2."
}