{"version":"0.1","base_model":"factory_planning_2","rules":[{"name":"Jun_make_at_least_3x_May_make","measure":"make","scope":{"month":"Jun"},"sense":">=","relative_to":{"measure":"make","scope":{"month":"May"}},"factor":3.0},{"name":"total_store_at_least_2x_total_sell","measure":"store","sense":">=","relative_to":{"measure":"sell"},"factor":2.0}],"note":"Units made in June must be at least 3 times units made in May; total inventory must be at least twice total sales."}