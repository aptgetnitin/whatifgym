{
  "version": "0.1",
  "base_model": "farm_planning",
  "rules": [
    {
      "name": "raise_heifers_to_grain_ratio",
      "measure": "raise_heifers",
      "scope": {
        "year": ["Year1", "Year2", "Year3", "Year4", "Year5"]
      },
      "sense": "<=",
      "relative_to": {
        "measure": "grow_grain",
        "scope": {
          "year": ["Year1", "Year2", "Year3", "Year4", "Year5"],
          "land_group": ["Group1", "Group2", "Group3", "Group4"]
        }
      },
      "factor": 0.25
    }
  ],
  "note": "Limit total heifer calves raised to at most 25% of total grain grown."
}