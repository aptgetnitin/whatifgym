{
 "version": "0.1",
 "base_model": "factory_planning",
 "logic": [
  {
   "name": "stock_above_zero_feb",
   "at_least": 1,
   "of": [
    {
     "measure": "store",
     "sense": ">",
     "value": 0,
     "scope": {
      "month": "Feb"
     }
    },
    {
     "measure": "sell",
     "sense": ">=",
     "value": 100,
     "scope": {
      "month": "Jun",
      "product": "Prod7"
     }
    }
   ]
  }
 ],
 "note": "Logical rule: at least 1 of the conditions hold. If stock is above zero in Feb, then sell >= 100 for Jun, Prod7."
}