{
 "version": "0.1",
 "base_model": "factory_planning",
 "rules": [
  {
   "name": "at_least_25_percent_to_jun",
   "measure": "make",
   "scope": {
    "month": "Jun"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "make",
    "scope": {
     "month": [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May"
     ]
    }
   },
   "factor": 0.25
  }
 ],
 "note": "A relative rule ensures that at least 25% of the total units made in the first five months are made in June."
}