{
 "version": "0.1",
 "base_model": "factory_planning",
 "data_changes": [
  {
   "op": "set",
   "table": "max_sales",
   "column": "max_sales",
   "where": {
    "product": "Prod7",
    "month": [
     "May",
     "Jun"
    ]
   },
   "value": 90
  }
 ],
 "rules": [
  {
   "name": "stock_unit_months_cap",
   "measure": "store",
   "scope": {
    "product": "*"
   },
   "sense": "<=",
   "value": 800
  }
 ],
 "note": "A data change sets the max_sales for Prod7 in May and June to 90. A rule limits the total unit-months of stock across all products to 800."
}