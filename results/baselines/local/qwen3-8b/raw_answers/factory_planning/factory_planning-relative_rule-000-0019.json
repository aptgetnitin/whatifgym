{
 "version": "0.1",
 "base_model": "factory_planning",
 "rules": [
  {
   "name": "jan_sales_cap",
   "measure": "sell",
   "scope": {
    "month": "Jan"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "sell",
    "scope": {
     "month": [
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun"
     ]
    }
   },
   "factor": 0.1
  }
 ],
 "note": "A relative sales cap over a subset of periods is a rule comparing the sum of sales in January to the sum of sales in the remaining months."
}