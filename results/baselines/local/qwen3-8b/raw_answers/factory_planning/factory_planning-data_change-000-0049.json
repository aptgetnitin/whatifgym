{
 "version": "0.1",
 "base_model": "factory_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "process_hours",
   "column": "hours_per_unit",
   "where": {
    "machine": "grinder",
    "product": "Prod7"
   },
   "factor": 0.625
  },
  {
   "op": "set",
   "table": "max_sales",
   "column": "max_sales",
   "where": {
    "product": "Prod3",
    "month": "Jan"
   },
   "value": 0
  }
 ],
 "note": "A process change scales the hours required for a product on a machine, and zero demand for a product in a month is set in the max_sales table."
}