{
 "version": "0.1",
 "base_model": "factory_planning",
 "rules": [
  {
   "name": "feb_sales_at_most_60_of_jan",
   "measure": "sell",
   "scope": {
    "month": "Feb"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "sell",
    "scope": {
     "month": "Jan"
    }
   },
   "factor": 0.6
  },
  {
   "name": "total_sales_at_most_75_of_total_stock",
   "measure": "sell",
   "scope": {
    "month": [
     "Jan",
     "Feb"
    ]
   },
   "sense": "<=",
   "relative_to": {
    "measure": "store",
    "scope": {
     "month": [
      "Jan",
      "Feb"
     ]
    }
   },
   "factor": 0.75
  }
 ],
 "note": "Two relative limits: Feb sales at most 60% of Jan sales, and total sales at most 75% of total stock."
}