{
 "version": "0.1",
 "base_model": "factory_planning",
 "rules": [
  {
   "name": "at_least_40_percent_sold_in_mar",
   "measure": "sell",
   "scope": {
    "month": "Mar"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "sell",
    "scope": {
     "month": "all"
    }
   },
   "factor": 0.4
  },
  {
   "name": "stock_jan_at_least_1_5_times_stock_may",
   "measure": "store",
   "scope": {
    "month": "Jan"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "store",
    "scope": {
     "month": "May"
    }
   },
   "factor": 1.5
  }
 ],
 "note": "Two relative rules: at least 40% of total units sold must be in March, and stock in January must be at least 1.5 times that in May."
}