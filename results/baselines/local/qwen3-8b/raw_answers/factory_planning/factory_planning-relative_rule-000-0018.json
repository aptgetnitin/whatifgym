{
 "version": "0.1",
 "base_model": "factory_planning",
 "rules": [
  {
   "name": "min_sales_mar",
   "measure": "sell",
   "scope": {
    "month": "Mar"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "sell",
    "scope": {
     "month": "all"
    }
   },
   "factor": 0.4
  },
  {
   "name": "store_jan_at_least_1_5_times_may",
   "measure": "store",
   "scope": {
    "month": "Jan"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "store",
    "scope": {
     "month": "May"
    }
   },
   "factor": 1.5
  }
 ],
 "note": "Two relative limits are imposed on the total units sold and the units in stock for specific months."
}