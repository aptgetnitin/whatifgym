{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "t15_at_least_half_temp_facilities",
   "measure": "build",
   "scope": {
    "facility": "T15"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "build",
    "scope": {
     "kind": "temporary"
    }
   },
   "factor": 0.5
  }
 ],
 "note": "A rule ensures that the number of temporary facilities built at T15 is at least half of all temporary facilities built."
}