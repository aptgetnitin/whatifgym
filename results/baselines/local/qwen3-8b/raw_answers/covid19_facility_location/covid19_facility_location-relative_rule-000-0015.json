{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "facility_e4_at_least_twice_e3",
   "measure": "assign",
   "scope": {
    "facility": "E4"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "facility": "E3"
    }
   },
   "factor": 2.0
  }
 ],
 "note": "The rule ensures that the total patients assigned to facility E4 is at least twice the total patients assigned to facility E3."
}