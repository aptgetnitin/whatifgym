{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "e9_min_assigned_if_e1_assigned",
   "measure": "assign",
   "scope": {
    "facility": "E9"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "facility": "E1"
    }
   },
   "factor": 380
  }
 ],
 "note": "If patients are assigned to facility E1, then patients assigned to facility E9 must be at least 380."
}