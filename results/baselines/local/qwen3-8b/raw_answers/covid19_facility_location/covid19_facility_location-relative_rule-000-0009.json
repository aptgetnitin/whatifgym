{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "facility_e4_at_least_1_5_e1",
   "measure": "assign",
   "scope": {
    "facility": "E4"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "facility": "E1"
    }
   },
   "factor": 1.5
  }
 ],
 "note": "The rule ensures that the total patients assigned to facility E4 is at least 1.5 times the total patients assigned to facility E1."
}