{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "data_changes": [
  {
   "op": "scale",
   "table": "counties",
   "column": "demand",
   "where": {
    "county": [
     "C1",
     "C2",
     "C3",
     "C4",
     "C5",
     "C6",
     "C7",
     "C8",
     "C9"
    ]
   },
   "factor": 1.2
  }
 ],
 "note": "Demand for all counties is scaled by 1.2 to simulate a 20% increase in forecasted patients."
}