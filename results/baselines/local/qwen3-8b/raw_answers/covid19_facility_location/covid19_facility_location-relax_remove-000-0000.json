{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "data_changes": [
  {
   "op": "scale",
   "table": "facilities",
   "column": "capacity",
   "where": {
    "facility": "T16"
   },
   "factor": 1000
  }
 ],
 "note": "The bed-capacity limit for facility T16 is lifted by scaling its capacity to 1000 beds."
}