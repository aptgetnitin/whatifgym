{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "t18_temp_facility_ratio",
   "measure": "build",
   "scope": {
    "facility": "T18"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "build",
    "scope": {
     "facility": "T15"
    }
   },
   "factor": 0.9
  },
  {
   "name": "t18_temp_facility_total_ratio",
   "measure": "build",
   "scope": {
    "facility": "T18"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "build",
    "scope": {
     "facility": "T15"
    }
   },
   "factor": 0.4
  }
 ],
 "note": "Two relative limits: T18 must account for at least 40% of the total number of temporary facilities built; and the number of temporary facilities built for T15 must be at most 90% of the number of temporary facilities built for T18."
}