{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "t17_temp_facilities_at_least_75_of_total",
   "measure": "build",
   "scope": {
    "facility": "T17"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "build",
    "scope": {
     "kind": "temporary"
    }
   },
   "factor": 0.75
  },
  {
   "name": "t18_temp_facilities_at_least_3_times_t17",
   "measure": "build",
   "scope": {
    "facility": "T18"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "build",
    "scope": {
     "facility": "T17"
    }
   },
   "factor": 3
  }
 ],
 "note": "Two relative limits: T17 must account for at least 75% of the total temporary facilities built, and T18 must be at least 3 times the number of T17 facilities."
}