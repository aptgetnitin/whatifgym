{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "t18_temp_facility_share",
   "measure": "build",
   "scope": {
    "facility": "T18"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "build",
    "scope": {
     "kind": "temporary"
    }
   },
   "factor": 0.75
  }
 ],
 "note": "A rule ensures that the number of patients assigned to T18 is at least 75% of the total number of temporary facilities built."
}