{
 "version": "0.1",
 "base_model": "covid19_facility_location",
 "rules": [
  {
   "name": "c7_to_e9_positive",
   "measure": "assign",
   "scope": {
    "county": "C7",
    "facility": "E9"
   },
   "sense": ">=",
   "value": 1
  },
  {
   "name": "c5_to_e6_at_least_420",
   "measure": "assign",
   "scope": {
    "county": "C5",
    "facility": "E6"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "county": "C7",
     "facility": "E9"
    }
   },
   "factor": 420
  }
 ],
 "note": "A logical rule: if patients assigned from county C7 to facility E9 is positive, then the total patients assigned from county C5 to facility E6 has to be 420 or more."
}