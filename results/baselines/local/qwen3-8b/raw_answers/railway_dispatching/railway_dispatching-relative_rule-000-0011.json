{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "f_trains_clearing_before_other",
   "measure": "goes_first",
   "scope": {
    "resource": [
     0,
     1,
     2,
     3,
     4,
     5,
     6
    ],
    "train": "F"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "goes_first",
    "scope": {
     "resource": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
     ],
     "other_train": [
      "A",
      "B",
      "C",
      "D",
      "E"
     ]
    }
   },
   "factor": 0.05
  }
 ],
 "note": "The rule limits the proportion of resources where train F clears before other trains, relative to the total number of such events."
}