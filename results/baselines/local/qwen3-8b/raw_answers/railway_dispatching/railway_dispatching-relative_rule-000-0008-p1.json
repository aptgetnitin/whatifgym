{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "e_arrival_at_least_twice_c",
   "measure": "finish_time",
   "scope": {
    "train": "E"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "finish_time",
    "scope": {
     "train": "C"
    }
   },
   "factor": 2
  },
  {
   "name": "b_entry_time_at_most_5_percent_total",
   "measure": "entry_time",
   "scope": {
    "train": "B"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "train": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F"
     ]
    }
   },
   "factor": 0.05
  }
 ],
 "note": "Rules enforce that train E's arrival time is at least twice train C's and train B's entry time is at most 5% of the total entry time of all trains."
}