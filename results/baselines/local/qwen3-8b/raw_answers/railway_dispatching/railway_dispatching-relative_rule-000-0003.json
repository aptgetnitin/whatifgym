{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "d_finish_at_least_25_of_f_finish",
   "measure": "finish_time",
   "scope": {
    "train": "D"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "finish_time",
    "scope": {
     "train": "F"
    }
   },
   "factor": 0.25
  }
 ],
 "note": "The arrival time for train D must be at least 25% of the arrival time for train F."
}