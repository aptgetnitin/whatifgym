{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "e_arrival_double_c",
   "measure": "finish_time",
   "scope": {
    "train": "E"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "finish_time",
    "scope": {
     "train": "C"
    }
   },
   "factor": 2.0
  },
  {
   "name": "b_entry_time_5_percent",
   "measure": "entry_time",
   "scope": {
    "train": "B"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "train": "A",
     "train": "B",
     "train": "C",
     "train": "D",
     "train": "E",
     "train": "F"
    }
   },
   "factor": 0.05
  }
 ],
 "note": "Rules enforce that train E's arrival time is at least double that of train C and that no more than 5% of the total entry time belongs to train B."
}