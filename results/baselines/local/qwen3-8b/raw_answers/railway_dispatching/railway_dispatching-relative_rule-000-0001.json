  {
   "name": "d_meet_share_at_least_1_5_b",
   "measure": "meet",
   "scope": {
    "resource": "*",
    "train": "D"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "meet",
    "scope": {
     "resource": "*",
     "train": "B"
    }
   },
   "factor": 1.5
  }
 ],
 "note": "Rules bound the SUM of a decision measure over a scope; a relative rule compares two such sums."
}