{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "total_arrival_time_limit",
   "measure": "finish_time",
   "scope": {
    "train": [
     "A",
     "B",
     "C",
     "D",
     "E",
     "F"
    ]
   },
   "sense": "<=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "train": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F"
     ],
     "resource": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6"
     ]
    }
   },
   "factor": 0.25
  }
 ],
 "note": "The rule enforces that the total arrival time at the destination is at or below 25% of the total entry time across all trains and resources."
}