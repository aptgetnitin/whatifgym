{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "arrival_time_b_at_most_2_times_d",
   "measure": "finish_time",
   "scope": {
    "train": "B"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "finish_time",
    "scope": {
     "train": "D"
    }
   },
   "factor": 2
  }
 ],
 "note": "The arrival time for train B must be at most twice the arrival time for train D."
}