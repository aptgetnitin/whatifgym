{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "entry_time_resource_1_twice_resource_3",
   "measure": "entry_time",
   "scope": {
    "resource": 1
   },
   "sense": ">=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "resource": 3
    }
   },
   "factor": 2
  },
  {
   "name": "resource_2_entry_time_at_most_10_percent",
   "measure": "entry_time",
   "scope": {
    "resource": 2
   },
   "sense": "<=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "resource": [
      1,
      3,
      4,
      5,
      6
     ]
    }
   },
   "factor": 0.1
  }
 ],
 "note": "The rules enforce that the entry time on resource 1 is at least twice that on resource 3, and the entry time on resource 2 is at most 10% of the total entry time across all resources."
}