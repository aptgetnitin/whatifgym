{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "entry_time_A_limit",
   "measure": "entry_time",
   "scope": {
    "train": "A"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "train": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F"
     ]
    }
   },
   "factor": 0.1
  }
 ],
 "note": "A relative limit on the sum of entry times for train A compared to all trains."
}