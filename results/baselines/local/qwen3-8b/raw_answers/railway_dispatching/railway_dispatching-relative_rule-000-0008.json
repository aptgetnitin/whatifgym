{
 "version": "0.1",
 "base_model": "railway_dispatching",
 "rules": [
  {
   "name": "arrival_e_at_least_twice_c",
   "measure": "finish_time",
   "scope": {
    "train": "E"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "finish_time",
    "scope": {
     "train": "C"
    }
   },
   "factor": 2
  },
  {
   "name": "entry_time_b_at_most_5_percent_total",
   "measure": "entry_time",
   "scope": {
    "train": "B"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "entry_time",
    "scope": {
     "train": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F"
     ]
    }
   },
   "factor": 0.05
  }
 ],
 "note": "Rules enforce the arrival time relationship between train E and C, and limit the proportion of total entry time attributed to train B."
}