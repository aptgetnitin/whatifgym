{
 "version": "0.1",
 "base_model": "assignment_with_constraints",
 "rules": [
  {
   "name": "task_2_at_least_25_percent_of_all_assignments",
   "measure": "assign",
   "scope": {
    "task": "task_2"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "task": "*"
    }
   },
   "factor": 0.25
  }
 ],
 "note": "The rule ensures that the number of assignments for task_2 is at least 25% of the total number of task assignments."
}