{
 "version": "0.1",
 "base_model": "assignment_with_constraints",
 "rules": [
  {
   "name": "team_10_11_at_least_1_5_times_team_0_1",
   "measure": "team",
   "scope": {
    "team": "team_10_11"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "team",
    "scope": {
     "team": "team_0_1"
    }
   },
   "factor": 1.5
  },
  {
   "name": "workers_working_to_worker_10_at_most_5_percent",
   "measure": "works",
   "scope": {
    "worker": "worker_10"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "works",
    "scope": {
     "worker": [
      "worker_0",
      "worker_1",
      "worker_2",
      "worker_3",
      "worker_4",
      "worker_5",
      "worker_6",
      "worker_7",
      "worker_8",
      "worker_9",
      "worker_10",
      "worker_11"
     ]
    }
   },
   "factor": 0.05
  }
 ],
 "note": "Two relative limits: team_10_11 is at least 1.5 times team_0_1, and worker_10's working count is at most 5% of total workers working."
}