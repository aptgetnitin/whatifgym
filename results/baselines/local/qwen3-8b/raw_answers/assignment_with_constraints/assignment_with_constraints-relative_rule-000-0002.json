{
 "version": "0.1",
 "base_model": "assignment_with_constraints",
 "rules": [
  {
   "name": "task_assignments_vs_workers",
   "measure": "assign",
   "scope": {
    "worker": "*",
    "task": "*"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "works",
    "scope": {
     "worker": "*"
    }
   },
   "factor": 1.5
  }
 ],
 "objective": [
  {
   "sense": "min",
   "measure": "original"
  }
 ],
 "note": "The rule enforces that the total number of task assignments is at least 1.5 times the number of workers working, which affects the optimization objective."
}