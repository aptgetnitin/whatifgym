{
 "version": "0.1",
 "base_model": "assignment_with_constraints",
 "data_changes": [
  {
   "op": "scale",
   "table": "costs",
   "column": "cost",
   "where": {
    "worker": "*",
    "task": "*"
   },
   "factor": 1.2
  },
  {
   "op": "set",
   "table": "tasks",
   "column": "min_workers",
   "where": {
    "task": "task_4"
   },
   "value": 2
  }
 ],
 "note": "Scale all costs by 20% and set the minimum workers for task_4 to 2."
}