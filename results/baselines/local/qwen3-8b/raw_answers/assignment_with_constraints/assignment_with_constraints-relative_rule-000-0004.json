{
 "version": "0.1",
 "base_model": "assignment_with_constraints",
 "rules": [
  {
   "name": "task_assignments_to_workers",
   "measure": "assign",
   "scope": {
    "worker": "*"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "works",
    "scope": {
     "worker": "*"
    }
   },
   "factor": 1.25
  }
 ],
 "objective": [
  {
   "sense": "min",
   "measure": "original"
  }
 ],
 "note": "The rule ensures the total number of task assignments is at least 1.25 times the number of workers working, affecting the overall cost optimization."
}