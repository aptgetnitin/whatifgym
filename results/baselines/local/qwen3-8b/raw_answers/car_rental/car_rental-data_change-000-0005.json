{
 "version": "0.1",
 "base_model": "car_rental",
 "data_changes": [
  {
   "op": "set",
   "table": "rental_lengths",
   "column": "price_other_depot",
   "where": {
    "rental_days": 3
   },
   "value": 300
  },
  {
   "op": "scale",
   "table": "transfer_costs",
   "column": "cost",
   "where": {
    "from_depot": "Manchester",
    "to_depot": "Plymouth"
   },
   "factor": 1.3
  }
 ]
}