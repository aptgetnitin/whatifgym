{
 "version": "0.1",
 "base_model": "car_rental",
 "logic": [
  {
   "name": "no_repair_on_wednesday_and_monday",
   "at_least": 1,
   "of": [
    {
     "measure": "repairs",
     "sense": ">=",
     "value": 1,
     "scope": {
      "day": "Wednesday",
      "depot": "*"
     }
    },
    {
     "measure": "repairs",
     "sense": ">=",
     "value": 1,
     "scope": {
      "day": "Monday",
      "depot": "*"
     }
    }
   ]
  }
 ]
}