{
 "version": "0.1",
 "base_model": "car_rental",
 "logic": [
  {
   "name": "damaged_transfers_tuesday_if_repairs_wednesday",
   "at_least": 1,
   "of": [
    {
     "measure": "damaged_transfers",
     "sense": ">=",
     "value": 15,
     "scope": {
      "day": "Tuesday"
     }
    },
    {
     "measure": "repairs",
     "sense": ">",
     "value": 0,
     "scope": {
      "day": "Wednesday"
     }
    }
   ]
  }
 ]
}