{
 "version": "0.1",
 "base_model": "car_rental",
 "data_changes": [
  {
   "op": "set",
   "table": "demand",
   "column": "demand",
   "where": {
    "day": "Monday",
    "depot": "Glasgow"
   },
   "value": 50
  },
  {
   "op": "scale",
   "table": "rental_lengths",
   "column": "price_other_depot",
   "where": {
    "rental_days": 3
   },
   "factor": 1.2
  }
 ],
 "note": "The demand for Monday, Glasgow is set to 50, and the price for 3-day rentals returned to another depot is increased by 20%."
}