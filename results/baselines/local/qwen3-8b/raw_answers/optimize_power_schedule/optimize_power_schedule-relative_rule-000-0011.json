{
 "version": "0.1",
 "base_model": "optimize_power_schedule",
 "rules": [
  {
   "name": "scherer_plant_hours_limit",
   "measure": "on",
   "scope": {
    "plant": "Scherer"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "on",
    "scope": {
     "plant": "*"
    }
   },
   "factor": 0.05
  },
  {
   "name": "shutdowns_limit",
   "measure": "stop",
   "scope": {
    "plant": "*"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "start",
    "scope": {
     "plant": "*"
    }
   },
   "factor": 0.9
  }
 ],
 "note": "Two relative limits are applied: Scherer's plant-hours on is at most 5% of total plant-hours on; total shut-downs is at most 90% of total start-ups."
}