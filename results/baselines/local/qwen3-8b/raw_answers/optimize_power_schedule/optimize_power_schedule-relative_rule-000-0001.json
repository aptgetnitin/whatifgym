    "plant": "Scherer"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "on",
    "scope": {
     "plant": "BIOMASS"
    }
   },
   "factor": 3
  }
 ],
 "note": "The first rule limits the number of plant shut-downs in hour 8 to 15% of the total. The second rule ensures that the number of plant-hours on for Scherer is at least three times that for BIOMASS."
