{
 "version": "0.1",
 "base_model": "optimize_power_schedule",
 "data_changes": [
  {
   "op": "set",
   "table": "plants",
   "column": "must_run",
   "where": {
    "plant": "GAS"
   },
   "value": 0
  }
 ],
 "rules": [
  {
   "name": "total_start_ups_limit",
   "measure": "start",
   "scope": {
    "plant": "*",
    "hour": "*"
   },
   "sense": "<=",
   "value": 1
  },
  {
   "name": "gas_power_generation_limit",
   "measure": "output",
   "scope": {
    "plant": "GAS",
    "hour": "*"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "output",
    "scope": {
     "plant": "GAS",
     "hour": "*"
    }
   },
   "factor": 32500
  }
 ],
 "note": "The total number of plant start-ups is limited to 1, and the total power generated by GAS is at least 32500 MWh."
}