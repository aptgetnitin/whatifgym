{
 "version": "0.1",
 "base_model": "power_generation_hydro",
 "rules": [
  {
   "name": "reservoir_level_09-15_at_least_3_times_15-18",
   "measure": "reservoir_level",
   "scope": {
    "period": "09-15"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "reservoir_level",
    "scope": {
     "period": "15-18"
    }
   },
   "factor": 3
  },
  {
   "name": "total_hydro_units_running_at_least_thermal_units_started",
   "measure": "hydro_on",
   "scope": {
    "hydro": [
     "HydroA",
     "HydroB"
    ]
   },
   "sense": ">=",
   "relative_to": {
    "measure": "nstart",
    "scope": {
     "type": [
      "Thermal0",
      "Thermal1",
      "Thermal2"
     ]
    }
   },
   "factor": 1
  }
 ],
 "note": "Two relative limits: reservoir level for period 09-15 is at least 3 times that for 15-18; total hydro units running is at least the total thermal units started."
}