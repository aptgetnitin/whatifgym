{
 "version": "0.1",
 "base_model": "power_generation_hydro",
 "data_changes": [
  {
   "op": "scale",
   "table": "thermal_types",
   "column": "cost_per_hour",
   "where": {
    "type": "Thermal2"
   },
   "factor": 1
  },
  {
   "op": "scale",
   "table": "thermal_types",
   "column": "cost_per_mwh_above_min",
   "where": {
    "type": "Thermal2"
   },
   "factor": 1
  }
 ],
 "note": "The hourly running cost for each Thermal2 unit is set to 6000."
}