{
 "version": "0.1",
 "base_model": "power_generation_hydro",
 "rules": [
  {
   "name": "thermal1_output_limit",
   "measure": "output",
   "scope": {
    "type": "Thermal1"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "output",
    "scope": {
     "type": "Thermal0"
    }
   },
   "factor": 0.25
  }
 ],
 "note": "The thermal output for Thermal1 is limited to 25% of the thermal output for Thermal0 across all periods."
}