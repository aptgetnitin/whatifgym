{
 "version": "0.1",
 "base_model": "power_generation_hydro",
 "rules": [
  {
   "name": "reservoir_level_15-18_at_least_75%",
   "measure": "reservoir_level",
   "scope": {
    "period": "15-18"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "reservoir_level",
    "scope": {
     "period": [
      "00-06",
      "06-09",
      "09-15",
      "18-24"
     ]
    }
   },
   "factor": 0.75
  },
  {
   "name": "thermal_start_00-06_at_most_60%_of_thermal_start_15-18",
   "measure": "nstart",
   "scope": {
    "period": "00-06",
    "type": [
     "Thermal0",
     "Thermal1",
     "Thermal2"
    ]
   },
   "sense": "<=",
   "relative_to": {
    "measure": "nstart",
    "scope": {
     "period": "15-18",
     "type": [
      "Thermal0",
      "Thermal1",
      "Thermal2"
     ]
    }
   },
   "factor": 0.6
  }
 ],
 "note": "The first rule ensures that at least 75% of the total reservoir level is allocated to the 15-18 period. The second rule limits the number of thermal units started in the 00-06 period to 60% of those started in the 15-18 period."
}