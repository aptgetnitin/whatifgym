{
 "version": "0.1",
 "base_model": "power_generation_hydro",
 "data_changes": [
  {
   "op": "set",
   "table": "thermal_types",
   "column": "min_output_mw",
   "where": {
    "type": "Thermal1"
   },
   "value": 0
  },
  {
   "op": "set",
   "table": "thermal_types",
   "column": "max_output_mw",
   "where": {
    "type": "Thermal1"
   },
   "value": 0
  }
 ],
 "rules": [
  {
   "name": "thermal1_output_zero",
   "measure": "output",
   "scope": {
    "period": "18-24",
    "type": "Thermal1"
   },
   "sense": "==",
   "value": 0
  }
 ],
 "note": "Setting min and max output for Thermal1 to zero effectively disables it for period 18-24."
}