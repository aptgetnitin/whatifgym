{
 "version": "0.1",
 "base_model": "battery_scheduling",
 "rules": [
  {
   "name": "soc_21-22_at_most_25_of_soc_16-17",
   "measure": "soc",
   "scope": {
    "hour": "21-22"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "soc",
    "scope": {
     "hour": "16-17"
    }
   },
   "factor": 0.25
  }
 ],
 "note": "A rule limits the stored energy in hour 21-22 to at most 25% of the stored energy in hour 16-17."
}