{
 "version": "0.1",
 "base_model": "battery_scheduling",
 "rules": [
  {
   "name": "soc_22-23_at_least_2_times_soc_16-17",
   "measure": "soc",
   "scope": {
    "hour": "22-23"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "soc",
    "scope": {
     "hour": "16-17"
    }
   },
   "factor": 2
  }
 ],
 "note": "The rule enforces that the stored energy in hour 22-23 is at least twice the stored energy in hour 16-17."
}