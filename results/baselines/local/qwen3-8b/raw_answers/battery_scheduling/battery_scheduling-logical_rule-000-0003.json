{
 "version": "0.1",
 "base_model": "battery_scheduling",
 "rules": [
  {
   "name": "at_most_4_non_zero_soc",
   "measure": "soc",
   "scope": {
    "hour": [
     "02-03",
     "06-07",
     "18-19",
     "07-08",
     "04-05"
    ]
   },
   "sense": "<=",
   "value": 4
  }
 ],
 "note": "A rule limits the sum of stored energy (soc) over the specified hours to at most 4 non-zero values."
}