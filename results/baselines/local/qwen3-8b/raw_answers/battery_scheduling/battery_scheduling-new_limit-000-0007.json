{
 "version": "0.1",
 "base_model": "battery_scheduling",
 "data_changes": [
  {
   "op": "set",
   "table": "params",
   "column": "terminal_soc_kwh",
   "where": {
    "name": "terminal_soc_kwh"
   },
   "value": 140
  }
 ],
 "rules": [
  {
   "name": "discharge_limit_21-22",
