{
 "version": "0.1",
 "base_model": "battery_scheduling",
 "rules": [
  {
   "name": "soc_19-20_requires_charge_03-04",
   "measure": "soc",
   "scope": {
    "hour": "19-20"
   },
   "sense": ">",
   "value": 0
  },
  {
   "name": "charge_03-04_min",
   "measure": "charge",
   "scope": {
    "hour": "03-04"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "soc",
    "scope": {
     "hour": "19-20"
    }
   },
   "factor": 0.5
  }
 ],
 "note": "A non-zero stored energy in hour 19-20 requires a minimum charging power in hour 03-04 based on the stored energy."
}