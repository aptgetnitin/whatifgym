{
  "version": "0.1",
  "base_model": "economic_planning",
  "data_changes": [
    {
      "op": "scale",
      "table": "input_output",
      "column": "input_per_unit_output",
      "where": {
        "supplier": ["coal", "steel", "transport"],
        "user": ["coal", "steel", "transport"]
      },
      "factor": 0.8
    },
    {
      "op": "set",
      "table": "industries",
      "column": "external_demand",
      "where": {
        "industry": "coal"
      },
      "value": 30
    }
  ],
  "note": "The input per unit of output is scaled down by 20% for all rows in the input-output table, and the exogenous consumption demand for coal is set to 30."
}