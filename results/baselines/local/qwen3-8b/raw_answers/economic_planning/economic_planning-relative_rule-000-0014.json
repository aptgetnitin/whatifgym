{
 "version": "0.1",
 "base_model": "economic_planning",
 "rules": [
  {
   "name": "stock_year2_at_least_2_times_stock_year1",
   "measure": "stock",
   "scope": {
    "year": 2
   },
   "sense": ">=",
   "relative_to": {
    "measure": "stock",
    "scope": {
     "year": 1
    }
   },
   "factor": 2.0
  }
 ],
 "note": "The stock in year 2 must be at least twice the stock in year 1."
}