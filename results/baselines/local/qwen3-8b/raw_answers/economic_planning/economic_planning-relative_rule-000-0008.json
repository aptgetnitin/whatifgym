{
 "version": "0.1",
 "base_model": "economic_planning",
 "rules": [
  {
   "name": "total_output_stock_ratio",
   "measure": "production",
   "scope": {
    "year": [1, 2, 3, 4, 5],
    "industry": ["coal", "steel", "transport"]
   },
   "sense": "<=",
   "relative_to": {
    "measure": "stock",
    "scope": {
     "year": [1, 2, 3, 4, 5],
     "industry": ["coal", "steel", "transport"]
    }
   },
   "factor": 0.9
  }
 ],
 "note": "The total output produced across all industries and years is bounded by 90% of the total stock held across the same periods."
}