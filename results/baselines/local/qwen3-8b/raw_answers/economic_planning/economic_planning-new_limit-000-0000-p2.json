{
 "version": "0.1",
 "base_model": "economic_planning",
 "rules": [
  {
   "name": "transport_output_sum",
   "measure": "production",
   "scope": {
    "industry": "transport"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "production",
    "scope": {
     "industry": [
      "coal",
      "steel"
     ]
    }
   },
   "factor": 1.0
  }
 ],
 "note": "The total output for transport must be at least as much as the combined output of coal and steel."
}