{
 "version": "0.1",
 "base_model": "mining",
 "rules": [
  {
   "name": "open_mine_years_limit",
   "measure": "open",
   "scope": {
    "mine": "*"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "operate",
    "scope": {
     "mine": "*"
    }
   },
   "factor": 0.5
  },
  {
   "name": "blend_year1_at_least_2_year3",
   "measure": "blend",
   "scope": {
    "year": "Year1"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "blend",
    "scope": {
     "year": "Year3"
    }
   },
   "factor": 2.0
  }
 ],
 "objective": [
  {
   "sense": "max",
   "measure": "original"
  }
 ],
 "note": "The scenario imposes two conditions: the total number of mine-years kept open is at most 50% of the total number of mine-years worked, and the tons of blended ore sold in Year1 are at least twice those in Year3."
}