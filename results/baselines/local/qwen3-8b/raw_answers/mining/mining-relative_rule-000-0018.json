{
 "version": "0.1",
 "base_model": "mining",
 "rules": [
  {
   "name": "extract_year1_at_least_3_times_year2",
   "measure": "extract",
   "scope": {
    "year": "Year1"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "extract",
    "scope": {
     "year": "Year2"
    }
   },
   "factor": 3
  }
 ],
 "note": "The rule enforces that the total extraction in Year1 is at least three times that of Year2."
}