{
 "version": "0.1",
 "base_model": "mining",
 "rules": [
  {
   "name": "blend_ore_year2_at_least_75_percent",
   "measure": "blend",
   "scope": {
    "year": "Year2"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "blend",
    "scope": {
     "year": [
      "Year1",
      "Year2",
      "Year3",
      "Year4",
      "Year5"
     ]
    }
   },
   "factor": 0.75
  },
  {
   "name": "mine_years_worked_year2_at_least_1_25_times_year5",
   "measure": "operate",
   "scope": {
    "year": "Year2"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "operate",
    "scope": {
     "year": "Year5"
    }
   },
   "factor": 1.25
  }
 ],
 "note": "Two relative limits are applied: one on the blended ore tons sold in Year2 relative to the total, and one on the number of mine-years worked in Year2 relative to Year5."
}