{
 "version": "0.1",
 "base_model": "factory_planning_2",
 "logic": [
  {
   "name": "conditional_prod4_apr_sales",
   "at_least": 1,
   "of": [
    {
     "measure": "make",
     "scope": {
      "month": "Feb"
     },
     "sense": ">",
     "value": 0
    },
    {
     "measure": "sell",
     "scope": {
      "month": "Apr",
      "product": "Prod4"
     },
     "sense": ">=",
     "value": 150
    }
   ]
  }
 ],
 "note": "Logical rule: if any units are made in Feb, then sell of Prod4 in Apr must be at least 150."
}