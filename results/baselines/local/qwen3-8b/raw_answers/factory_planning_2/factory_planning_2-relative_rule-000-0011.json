{
 "version": "0.1",
 "base_model": "factory_planning_2",
 "rules": [
  {
   "name": "stock_above_sales",
   "measure": "store",
   "scope": {
    "month": [
     "Jan",
     "Feb",
     "Mar",
     "Apr",
     "May",
     "Jun"
    ]
   },
   "sense": ">=",
   "relative_to": {
    "measure": "sell",
    "scope": {
     "month": [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun"
     ]
    }
   },
   "factor": 1.0
  }
 ],
 "objective": [
  {
   "sense": "max",
   "measure": "original"
  }
 ],
 "note": "The rule ensures that the total units in stock across all months is at least the total units sold. The objective remains to maximise the original profit."
}