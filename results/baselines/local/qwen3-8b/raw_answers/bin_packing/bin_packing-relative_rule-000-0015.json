{
 "version": "0.1",
 "base_model": "bin_packing",
 "rules": [
  {
   "name": "min_bins_rule",
   "measure": "y",
   "scope": {
    "bin": "*"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "y",
    "scope": {
     "bin": "*"
    }
   },
   "factor": 0.9
  },
  {
   "name": "max_bin1_rule",
   "measure": "y",
   "scope": {
    "bin": "bin1"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "y",
    "scope": {
     "bin": "*"
    }
   },
   "factor": 0.15
  }
 ],
 "note": "Rules enforce that the total number of bins used is at least 90% of the total number of items packed and that at most 15% of the total items go to bin1."
}