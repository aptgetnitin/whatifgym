      "bin4",
      "bin5",
      "bin6",
      "bin7",
      "bin8",
      "bin9",
      "bin10"
     ]
    }
   },
   "factor": 1.5
  },
  {
   "name": "bin10_bins_used_limit",
   "measure": "y",
   "scope": {
    "bin": "bin10"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "y",
    "scope": {
     "bin": "bin0"
