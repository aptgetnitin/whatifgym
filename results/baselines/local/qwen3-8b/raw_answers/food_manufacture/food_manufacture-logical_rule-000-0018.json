{
 "version": "0.1",
 "base_model": "food_manufacture",
 "rules": [
  {
   "name": "jan_produce_at_least_mar_produce",
   "measure": "produce",
   "scope": {
    "month": "Jan"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "produce",
    "scope": {
     "month": "Mar"
    }
   },
   "factor": 1.0
  }
 ],
 "note": "A rule that enforces the total tons of food produced in January to be at least the total tons of food produced in March."
}