{
 "version": "0.1",
 "base_model": "food_manufacture",
 "rules": [
  {
   "name": "april_food_share",
   "measure": "produce",
   "scope": {
    "month": "Apr"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "produce",
    "scope": {
     "month": [
      "Jan",
      "Feb",
      "Mar",
      "May",
      "Jun"
     ]
    }
   },
   "factor": 0.2
  }
 ],
 "note": "A rule enforces that April's food production is at least 20% of the total production across all months."
}