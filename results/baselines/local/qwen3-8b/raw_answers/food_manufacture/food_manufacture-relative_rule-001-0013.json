{
 "version": "0.1",
 "base_model": "food_manufacture",
 "rules": [
  {
   "name": "storage_apr_at_least_15",
   "measure": "store",
   "scope": {
    "month": "Apr"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "store",
    "scope": {
     "month": [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun"
     ]
    }
   },
   "factor": 0.15
  },
  {
   "name": "oil2_refined_at_most_90_of_veg2",
   "measure": "consume",
   "scope": {
    "oil": "OIL2"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "consume",
    "scope": {
     "oil": "VEG2"
    }
   },
   "factor": 0.9
  }
 ],
 "note": "Rules enforce a storage requirement for April and a relative constraint on the refined tons of OIL2 compared to VEG2."
}