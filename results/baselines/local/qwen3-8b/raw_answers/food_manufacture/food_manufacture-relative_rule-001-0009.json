{
 "version": "0.1",
 "base_model": "food_manufacture",
 "rules": [
  {
   "name": "may_refining_at_least_twice_feb",
   "measure": "consume",
   "scope": {
    "month": "May"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "consume",
    "scope": {
     "month": "Feb"
    }
   },
   "factor": 2.0
  }
 ],
 "note": "The rule enforces that the total tons of oil refined in May is at least twice that of February."
}