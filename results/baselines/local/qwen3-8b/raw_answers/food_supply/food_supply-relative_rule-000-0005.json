{
  "version": "0.1",
  "base_model": "food_supply",
  "rules": [
    {
      "name": "total_purchase_at_least_three_times_total_flow",
      "measure": "purchase",
      "scope": {
        "food": "*",
        "supplier": "*"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "flow",
        "scope": {
          "food": "*",
          "from_city": "*",
          "to_city": "*"
        }
      },
      "factor": 3
    }
  ],
  "note": "The rule ensures that the total food purchased is at least three times the total food shipped, affecting the optimization objective."
}