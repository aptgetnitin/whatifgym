{
 "version": "0.1",
 "base_model": "food_supply",
 "rules": [
  {
   "name": "daraa_shipments_min",
   "measure": "flow",
   "scope": {
    "from_city": "*",
    "to_city": "Daraa"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "flow",
    "scope": {
     "from_city": "*",
     "to_city": "*"
    }
   },
   "factor": 0.1
  }
 ],
 "note": "A relative rule ensures that the total flow to Daraa is at least 10% of all food shipments."
}