     "depot": "Glasgow"
    }
   },
   "factor": 0.3
  }
 ],
 "note": "The first rule limits undamaged_stock at Glasgow on Friday to 200, and the second ensures that repairs on Friday account for at least 30% of the total repairs at Glasgow on Monday."
