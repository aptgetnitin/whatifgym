   "scope": {
    "day": "Friday",
    "depot": "Glasgow"
   },
   "sense": "<=",
   "value": 200
  },
  {
   "name": "friday_repair_contribution",
   "measure": "repairs",
   "scope": {
    "day": "Friday",
    "depot": "Glasgow"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "repairs",
