{
 "version": "0.1",
 "base_model": "car_rental_2",
 "rules": [
  {
   "name": "glasgow_undamaged_stock_min",
   "measure": "undamaged_stock",
   "scope": {
    "day": "Monday",
    "depot": "Glasgow"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "undamaged_stock",
    "scope": {
     "day": "Monday"
    }
   },
   "factor": 0.25
  }
 ],
 "note": "The rule ensures that undamaged_stock at Glasgow on Monday is at least 25% of the total undamaged_stock across all depots on Monday."
}