{
 "version": "0.1",
 "base_model": "car_rental_2",
 "rules": [
  {
   "name": "undamaged_left_saturday_tuesday",
   "measure": "undamaged_left",
   "scope": {
    "day": "Saturday"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "undamaged_left",
    "scope": {
     "day": "Tuesday"
    }
   },
   "factor": 1.0
  },
  {
   "name": "undamaged_transfers_thursday_limit",
   "measure": "undamaged_transfers",
   "scope": {
    "day": "Thursday"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "undamaged_transfers",
    "scope": {
     "day": "all"
    }
   },
   "factor": 0.05
  }
 ],
 "note": "The first rule ensures that the undamaged cars kept overnight on Saturday are at most the same as those on Tuesday. The second rule limits the undamaged transfers on Thursday to at most 5% of all undamaged transfers."
}