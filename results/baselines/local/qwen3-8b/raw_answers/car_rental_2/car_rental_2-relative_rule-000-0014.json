{
 "version": "0.1",
 "base_model": "car_rental_2",
 "rules": [
  {
   "name": "rentals_below_damaged_stock",
   "measure": "rentals",
   "scope": {
    "day": "Wednesday",
    "depot": "depot"
   },
   "sense": "<=",
   "relative_to": {
    "measure": "damaged_stock",
    "scope": {
