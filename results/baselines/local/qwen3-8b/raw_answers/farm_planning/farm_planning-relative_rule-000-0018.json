{
 "version": "0.1",
 "base_model": "farm_planning",
 "rules": [
  {
   "name": "sugar_beet_year2_at_least_3_times_year1",
   "measure": "grow_beet",
   "scope": {
    "year": "Year2"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "grow_beet",
    "scope": {
     "year": "Year1"
    }
   },
   "factor": 3
  }
 ],
 "note": "The rule enforces that the sugar beet grown in Year2 is at least three times the sugar beet grown in Year1."
}