{
  "version": "0.1",
  "base_model": "farm_planning",
  "objective": [
    {
      "sense": "max",
      "measure": "yearly_profit",
      "scope": {
        "year": ["Year1", "Year2", "Year3", "Year4", "Year5"]
      }
    },
    {
      "sense": "min",
      "measure": "grow_grain",
      "scope": {
        "year": ["Year1", "Year2", "Year3", "Year4", "Year5"],
        "land_group": ["Group1", "Group2", "Group3", "Group4"]
      }
    }
  ],
  "note": "The first stage maximises the five-year profit, and the second stage minimises the total grain grown across all years and land groups."
}