{
 "version": "0.1",
 "base_model": "technician_routing_scheduling",
 "rules": [
  {
   "name": "unfilled_at_least_125_assigned",
   "measure": "unfilled",
   "scope": {
    "customer": [
     "Customer1",
     "Customer2",
     "Customer3",
     "Customer4",
     "Customer5",
     "Customer6",
     "Customer7"
    ]
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "customer": [
      "Customer1",
      "Customer2",
      "Customer3",
      "Customer4",
      "Customer5",
      "Customer6",
      "Customer7"
     ]
    }
   },
   "factor": 1.25
  }
 ],
 "note": "The rule enforces that the total number of unfilled jobs is at least 1.25 times the total number of jobs assigned."
}