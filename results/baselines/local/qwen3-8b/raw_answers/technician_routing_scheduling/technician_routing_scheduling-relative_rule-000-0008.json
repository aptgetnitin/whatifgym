{
 "version": "0.1",
 "base_model": "technician_routing_scheduling",
 "rules": [
  {
   "name": "unfilled_jobs_rule",
   "measure": "unfilled",
   "scope": {
    "customer": "*"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "assign",
    "scope": {
     "customer": "*"
    }
   },
   "factor": 0.25
  }
 ],
 "note": "The rule ensures that the total number of unfilled jobs is at least 25% of the total number of jobs assigned."
}