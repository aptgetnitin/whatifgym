{
 "version": "0.1",
 "base_model": "manpower_planning",
 "rules": [
  {
   "name": "retrain_to_higher_skill_year_1",
   "measure": "retrain",
   "scope": {
    "year": 1,
    "from_skill": [
     "unskilled",
     "semi_skilled"
    ],
    "to_skill": [
     "semi_skilled",
     "skilled"
    ]
   },
   "sense": ">=",
   "value": 1
  },
  {
   "name": "overmanned_unskilled_at_least_860",
   "measure": "overmanned",
   "scope": {
    "year": 1,
    "skill": "unskilled"
   },
   "sense": ">=",
   "value": 860
  }
 ],
 "note": "A non-zero retraining to higher skill level in year 1 requires overmanning of unskilled workers to be at least 860."
}