{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "set",
   "table": "retraining",
   "column": "max_per_year",
   "where": {
    "from_skill": "unskilled",
    "to_skill": "semi_skilled",
    "year": [
     1,
     3
    ]
   },
   "value": 300
  },
  {
   "op": "set",
   "table": "retraining",
   "column": "max_per_year",
   "where": {
    "from_skill": "unskilled",
    "to_skill": "skilled",
    "year": [
     1,
     3
    ]
   },
   "value": 100
  },
  {
   "op": "set",
   "table": "retraining",
   "column": "max_share_of_target",
   "where": {
    "from_skill": "semi_skilled",
    "to_skill": "skilled",
    "year": [
     1,
     3
    ]
   },
   "value": 0.25
  }
 ],
 "note": "The retraining limits for year 1 and 3 are lifted by setting max_per_year and max_share_of_target to their original values."
}