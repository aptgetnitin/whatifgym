{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "requirements",
   "column": "required",
   "where": {
    "year": [1, 2, 3],
    "skill": ["unskilled", "semi_skilled", "skilled"]
   },
   "factor": 0.8
  }
 ],
 "note": "A relative reduction in required headcount across all skill levels and years is a scale over the matching rows."
}