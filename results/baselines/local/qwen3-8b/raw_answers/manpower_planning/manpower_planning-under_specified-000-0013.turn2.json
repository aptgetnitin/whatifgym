{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "requirements",
   "column": "required",
   "where": {
    "year": [1, 2, 3],
    "skill": ["unskilled", "semi_skilled", "skilled"]
   },
   "factor": 0.75
  },
  {
   "op": "scale",
   "table": "requirements",
   "column": "max_recruit",
   "where": {
    "year": [1, 2, 3],
    "skill": ["unskilled", "semi_skilled", "skilled"]
   },
   "factor": 0.75
  }
 ],
 "note": "The manpower requirement and recruitment limits are scaled down by 25% for all years and skill levels."
}