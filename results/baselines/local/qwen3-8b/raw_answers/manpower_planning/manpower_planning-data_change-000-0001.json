{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "skills",
   "column": "downgrade_attrition",
   "where": {
    "skill": [
     "unskilled",
     "semi_skilled",
     "skilled"
    ]
   },
   "factor": 1.25
  }
 ],
 "note": "The share of downgraded workers who leave is increased by 25% across all skill levels."
}