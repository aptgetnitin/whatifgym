{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "skills",
   "column": "current_strength",
   "where": {
    "skill": "skilled"
   },
   "factor": 0.75
  },
  {
   "op": "scale",
   "table": "costs",
   "column": "short_time_cost",
   "where": {
    "skill": [
     "unskilled",
     "semi_skilled",
     "skilled"
    ]
   },
   "factor": 1.2
  }
 ],
 "note": "The current workforce for the skilled skill level is reduced by 25%, and the short-time working cost per worker for all skill levels is increased by 20%."
}