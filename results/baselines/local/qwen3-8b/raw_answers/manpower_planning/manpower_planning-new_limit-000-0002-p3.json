{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "set",
   "table": "retraining",
   "column": "max_per_year",
   "where": {
    "from_skill": "unskilled",
    "to_skill": "semi_skilled"
   },
   "value": 0
  },
  {
   "op": "set",
   "table": "retraining",
   "column": "max_per_year",
   "where": {
    "from_skill": "semi_skilled",
    "to_skill": "skilled"
   },
   "value": 0
  },
  {
   "op": "set",
   "table": "retraining",
   "column": "max_per_year",
   "where": {
    "from_skill": "unskilled",
    "to_skill": "skilled"
   },
   "value": 0
  }
 ],
 "rules": [
  {
   "name": "downgrade_limit",
   "measure": "downgrade",
   "scope": {
    "year": [1, 2, 3],
    "from_skill": ["unskilled", "semi_skilled", "skilled"],
    "to_skill": ["unskilled", "semi_skilled", "skilled"]
   },
   "sense": "<=",
   "value": 130
  }
 ],
 "note": "The total number of workers downgraded to a lower skill level is limited to 130 across all years and skill levels."
}