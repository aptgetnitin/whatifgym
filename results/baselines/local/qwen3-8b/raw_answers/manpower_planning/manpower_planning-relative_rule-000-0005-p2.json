{
 "version": "0.1",
 "base_model": "manpower_planning",
 "rules": [
  {
   "name": "short_time_year_2_at_least_3_times_year_1",
   "measure": "short_time",
   "scope": {
    "year": 2
   },
   "sense": ">=",
   "relative_to": {
    "measure": "short_time",
    "scope": {
     "year": 1
    }
   },
   "factor": 3
  }
 ],
 "note": "The rule ensures that the total number of workers on short-time working in year 2 is at least three times that of year 1."
}