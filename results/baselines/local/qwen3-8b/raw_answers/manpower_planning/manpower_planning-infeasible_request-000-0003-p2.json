{
 "version": "0.1",
 "base_model": "manpower_planning",
 "data_changes": [
  {
   "op": "set",
   "table": "requirements",
   "column": "required",
   "where": {
    "year": 1,
    "skill": "unskilled"
   },
   "value": 450
  },
  {
   "op": "set",
   "table": "requirements",
   "column": "required",
   "where": {
    "year": 3,
    "skill": "unskilled"
   },
   "value": 450
  }
 ],
 "rules": [
  {
   "name": "overmanned_year_1",
   "measure": "overmanned",
   "scope": {
    "year": 1
   },
   "sense": ">=",
   "value": 450
  },
  {
   "name": "overmanned_year_3",
   "measure": "overmanned",
   "scope": {
    "year": 3
   },
   "sense": ">=",
   "value": 450
  }
 ],
 "objective": [
  {
   "sense": "min",
   "measure": "original"
  }
 ],
 "note": "The scenario sets the required workforce for unskilled workers in year 1 and year 3 to 450 and enforces that the overmanned workforce meets the minimum requirement of 450 in each year."
}