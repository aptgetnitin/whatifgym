{
 "version": "0.1",
 "base_model": "manpower_planning",
 "rules": [
  {
   "name": "redundant_unskilled_year_2_at_least_250",
   "measure": "redundant",
   "scope": {
    "year": 2,
    "skill": "unskilled"
   },
   "sense": ">=",
   "relative_to": {
    "measure": "recruit",
    "scope": {
     "year": 3,
     "skill": "unskilled"
    }
   },
   "factor": 1.0
  }
 ],
 "note": "A conditional rule: if recruit for year 3 unskilled is above zero, then redundant for year 2 unskilled must be at least 250."
}