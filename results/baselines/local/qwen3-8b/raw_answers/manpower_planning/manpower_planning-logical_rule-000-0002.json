{
 "version": "0.1",
 "base_model": "manpower_planning",
 "rules": [
  {
   "name": "retrain_to_higher_skill_year_2",
   "measure": "retrain",
   "scope": {
    "year": 2,
    "from_skill": [
     "unskilled",
     "semi_skilled"
    ],
    "to_skill": [
     "semi_skilled",
     "skilled"
    ]
   },
   "sense": ">=",
   "value": 0
  },
  {
   "name": "overmanned_unskilled_year_2",
   "measure": "overmanned",
   "scope": {
    "year": 2,
    "skill": "unskilled"
   },
   "sense": ">=",
   "value": 190
  }
 ],
 "note": "A non-zero retraining to higher skill level in year 2 requires at least 190 overmanned unskilled workers in year 2."
}