{

 "version": "0.1",
 "base_model": "factory_planning",
 "data_changes": [
  {
   "op": "scale",
   "table": "max_sales",
   "column": "max_sales",
   "where": {
    "product": "Prod1",
    "month": [
     "Jan",
     "Feb",
     "Mar"
    ]
   },
   "factor": 1.1
  }
 ],
 "note": "A 10% increase in demand for Prod1 in Jan-Mar is modeled by scaling the max_sales values for those months."
}