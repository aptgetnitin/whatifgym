{

 "version": "0.1",
 "base_model": "power_generation_hydro",
 "data_changes": [
  {
   "op": "scale",
   "table": "hydro_units",
   "column": "output_mw",
   "where": {
    "hydro": "HydroA"
   },
   "factor": 0.9
  },
  {
   "op": "set",
   "table": "thermal_types",
   "column": "units_available",
   "where": {
    "type": "Thermal1"
   },
   "value": 0
  }
 ],
 "note": "HydroA's output is reduced by 10% and Thermal1 is removed from the problem by setting its available units to zero."
}