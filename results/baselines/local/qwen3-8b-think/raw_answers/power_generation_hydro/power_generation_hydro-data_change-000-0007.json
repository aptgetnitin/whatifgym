{

 "version": "0.1",
 "base_model": "power_generation_hydro",
 "data_changes": [
  {
   "op": "set",
   "table": "hydro_units",
   "column": "output_mw",
   "where": {
    "hydro": "HydroB"
   },
   "value": 2800
  },
  {
   "op": "scale",
   "table": "thermal_types",
   "column": "cost_per_mwh_above_min",
   "where": {
    "type": [
     "Thermal0",
     "Thermal1",
     "Thermal2"
    ]
   },
   "factor": 1.25
  }
 ],
 "note": "HydroB's output is set to 2800 MW, and all thermal types' cost_per_mwh_above_min are increased by 25%."
}