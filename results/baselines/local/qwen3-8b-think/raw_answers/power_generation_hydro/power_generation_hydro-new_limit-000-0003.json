  {
   "name": "thermal0_output_cap",
   "measure": "output",
   "scope": {
    "type": "Thermal0"
   },
   "sense": "<=",
   "value": 39950
  }
 ],
 "note": "Enforces minimum Thermal1 units running and maximum Thermal0 output across all periods"
}