{

  "version": "0.1",
  "base_model": "manpower_planning",
  "data_changes": [
    {
      "op": "scale",
      "table": "skills",
      "column": "current_strength",
      "where": {
        "skill": "unskilled"
      },
      "factor": 1.1
    },
    {
      "op": "set",
      "table": "costs",
      "column": "short_time_cost",
      "where": {
        "skill": "unskilled"
      },
      "value": 1000
    }
  ],
  "note": "Increases unskilled workforce by 10% and updates short-time cost for unskilled workers"
}