{
  "version": "0.1",
  "base_model": "factory_planning_2",
  "rules": [
    {
      "name": "prod2_min_40pct_of_total_make",
      "measure": "make",
      "scope": {
        "product": "Prod2"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "make"
      },
      "factor": 0.4
    },
    {
      "name": "mar_store_at_most_90pct_of_jun",
      "measure": "store",
      "scope": {
        "month": "Mar"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "store",
        "scope": {
          "month": "Jun"
        }
      },
      "factor": 0.9
    }
  ],
  "note": "At least 40% of total production must be Prod2; stock in March must not exceed 90% of stock in June."
}