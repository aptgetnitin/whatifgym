{
  "version": "0.1",
  "base_model": "factory_planning_2",
  "rules": [
    {
      "name": "may_production_share",
      "measure": "make",
      "scope": {
        "month": "May"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "make"
      },
      "factor": 0.75
    },
    {
      "name": "prod4_vs_prod3_ratio",
      "measure": "make",
      "scope": {
        "product": "Prod4"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "make",
        "scope": {
          "product": "Prod3"
        }
      },
      "factor": 0.6
    }
  ],
  "note": "May must account for at least 75% of all units made; Prod4 production may be at most 60% of Prod3 production."
}