{
  "version": "0.1",
  "base_model": "factory_planning_2",
  "logic": [
    {
      "name": "sellAprProd1_implies_storeJunProd4",
      "at_least": 1,
      "of": [
        {
          "measure": "sell",
          "scope": {
            "month": "Apr",
            "product": "Prod1"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "store",
          "scope": {
            "month": "Jun",
            "product": "Prod4"
          },
          "sense": ">=",
          "value": 100
        }
      ]
    }
  ],
  "note": "If any units of Prod1 are sold in April, then at least 100 units of Prod4 must be in stock in June."
}