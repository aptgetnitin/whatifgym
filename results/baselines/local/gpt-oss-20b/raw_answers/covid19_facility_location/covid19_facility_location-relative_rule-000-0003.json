{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "T17_at_most_half_T18",
      "measure": "build",
      "scope": {
        "facility": "T17"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "build",
        "scope": {
