{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "E4_at_least_1.5_E1",
      "measure": "assign",
      "scope": {
        "facility": "E4"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "assign",
        "scope": {
          "facility": "E1"
        }
      },
      "factor": 1.5
    }
  ],
  "note": "Patients assigned to E4 must be at least 1.5 times those assigned to E1."
}