{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "check_both_assignments",
      "at_least": 2,
      "of": [
        {
          "measure": "assign",
          "scope": { "facility": "T17" },
          "sense": ">=",
          "value": 200
        },
        {
          "measure": "assign",
          "scope": { "facility": "E5" },
          "sense": ">=",
          "value": 560
        }
      ]
    }
  ],
  "note": "Check if both constraints can be satisfied simultaneously."
}