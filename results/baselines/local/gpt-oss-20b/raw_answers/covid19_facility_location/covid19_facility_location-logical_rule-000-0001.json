{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "E11_assignment_constraint",
      "at_least": 1,
      "of": [
        {
          "measure": "assign",
          "scope": {
            "facility": "E11"
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "assign",
          "scope": {
            "facility": "E11"
          },
          "sense": ">=",
          "value": 240
        }
      ]
    }
  ],
  "note": "Total patients assigned to facility E11 must be either zero or at least 240."
}