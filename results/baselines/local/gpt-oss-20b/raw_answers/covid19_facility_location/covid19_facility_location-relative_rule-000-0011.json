{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "T18_build_at_most_75pct_T17",
      "measure": "build",
      "scope": {
        "facility": "T18"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "build",
        "scope": {
          "facility": "T17"
        }
      },
      "factor": 0.75
    },
    {
      "name": "T18_assign_at_least_60pct_total",
      "measure": "assign",
      "scope": {
        "facility": "T18"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "assign",
        "scope": {}
      },
      "factor": 0.6
    }
  ],
  "note": "Relative limits on the number of temporary facilities built for T18 and on the share of patients assigned to T18."
}