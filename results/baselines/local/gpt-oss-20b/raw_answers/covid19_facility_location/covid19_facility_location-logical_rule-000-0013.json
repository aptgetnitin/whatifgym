{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "E2_assign_zero_or_at_least_370",
      "at_least": 1,
      "of": [
        {
          "measure": "assign",
          "scope": { "facility": "E2" },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "assign",
          "scope": { "facility": "E2" },
          "sense": ">=",
          "value": 370
        }
      ]
    }
  ],
  "note": "Total patients assigned to facility E2 must be either zero or at least 370."
}