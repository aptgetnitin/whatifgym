{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "E3_assign_limit",
      "measure": "assign",
      "scope": {
        "facility": "E3"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "assign"
      },
      "factor": 0.05
    },
    {
      "name": "T17_T18_build_ratio",
      "measure": "build",
      "scope": {
        "facility": "T17"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "build",
        "scope": {
          "facility": "T18"
        }
      },
      "factor": 3
    }
  ],
  "note": "Limit E3 assignments to 5% of total; enforce T17 built at least 3x T18."
}