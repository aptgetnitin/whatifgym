{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "E13_assign_zero_or_at_least_750",
      "at_least": 1,
      "of": [
        {
          "measure": "assign",
          "scope": {
            "facility": "E13"
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "assign",
          "scope": {
            "facility": "E13"
          },
          "sense": ">=",
          "value": 750
        }
      ]
    }
  ],
  "note": "Total patients assigned to facility E13 must be either zero or at least 750."
}