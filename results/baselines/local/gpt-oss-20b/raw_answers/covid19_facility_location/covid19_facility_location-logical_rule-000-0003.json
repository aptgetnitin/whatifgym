{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "C7_E13_requires_C5_450",
      "at_least": 1,
      "of": [
        {
          "measure": "assign",
          "scope": {
            "county": "C7",
            "facility": "E13"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "assign",
          "scope": {
            "county": "C5"
          },
          "sense": ">=",
          "value": 450
        }
      ]
    }
  ],
  "note": "If any patients are assigned from C7 to E13, then at least 450 patients must be assigned from C5 to any facility."
}