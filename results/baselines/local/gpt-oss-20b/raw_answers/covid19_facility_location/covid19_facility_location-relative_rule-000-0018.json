{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "T15_at_least_75pct_of_E11",
      "measure": "assign",
      "scope": {
        "facility": "T15"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "assign",
        "scope": {
          "facility": "E11"
        }
      },
      "factor": 0.75
    }
  ],
  "note": "Patients assigned to T15 must be at least 75% of those assigned to E11."
}