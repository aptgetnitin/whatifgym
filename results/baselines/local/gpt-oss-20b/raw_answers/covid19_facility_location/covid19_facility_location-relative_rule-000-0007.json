{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "E3_at_most_T18",
      "measure": "assign",
      "scope": {
        "facility": "E3"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "assign",
        "scope": {
          "facility": "T18"
        }
      },
      "factor": 1.0
    }
  ],
  "note": "Patients assigned to E3 must be at most the same as those assigned to T18."
}