{
  "version": "0.1",
  "base_model": "car_rental_2",
  "logic": [
    {
      "name": "rentals_tuesday_birmingham_implies_repair_monday",
      "at_least": 1,
      "of": [
        {
          "measure": "rentals",
          "scope": {
            "day": "Tuesday",
            "depot": "Birmingham"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "repairs",
          "scope": {
            "day": "Monday"
          },
          "sense": ">=",
          "value": 94
        }
      ]
    }
  ]
}