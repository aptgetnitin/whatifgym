{
  "version": "0.1",
  "base_model": "car_rental_2",
  "data_changes": [
    {
      "op": "scale",
      "table": "rental_lengths",
      "column": "price_other_depot",
      "where": {
        "rental_days": [1, 2, 3]
      },
      "factor": 0.8
    }
  ],
  "note": "Reduce the price for rentals that return to another depot by 20% across all rental lengths."
}