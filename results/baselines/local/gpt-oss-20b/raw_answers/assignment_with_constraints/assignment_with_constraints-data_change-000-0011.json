{
  "version": "0.1",
  "base_model": "assignment_with_constraints",
  "data_changes": [
    {
      "op": "scale",
      "table": "costs",
      "column": "cost",
      "where": {
        "task": [
          "task_0",
          "task_1",
          "task_2",
          "task_3",
          "task_4",
          "task_5"
        ]
      },
      "factor": 1.2
    },
    {
      "op": "set",
      "table": "tasks",
      "column": "min_workers",
      "where": {
        "task": "task_4"
      },
      "value": 2
    }
  ],
  "note": "Increase all assignment costs by 20% and require two workers for task_4."
}