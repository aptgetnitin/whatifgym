{
  "version": "0.1",
  "base_model": "battery_scheduling",
  "logic": [
    {
      "name": "soc_12_13_implies_discharge_21_22",
      "at_least": 1,
      "of": [
        {
          "measure": "soc",
          "scope": {
            "hour": "12-13"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "discharge",
          "scope": {
            "hour": "21-22"
          },
          "sense": ">=",
          "value": 6.2
        }
      ]
    }
  ],
  "note": "If any energy is stored in hour 12-13, then the discharge power in hour 21-22 must be at least 6.2 kW."
}