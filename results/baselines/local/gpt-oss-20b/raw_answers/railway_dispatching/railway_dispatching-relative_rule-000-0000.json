{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "rules": [
    {
      "name": "C_finish_at_most_25_percent_B",
      "measure": "finish_time",
      "scope": {
        "train": "C"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "finish_time",
        "scope": {
          "train": "B"
        }
      },
      "factor": 0.25
    }
  ],
  "note": "Finish time of train C must be at most 25% of the finish time of train B."
}