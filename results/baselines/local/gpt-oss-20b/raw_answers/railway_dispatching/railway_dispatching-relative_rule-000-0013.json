{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "rules": [
    {
      "name": "trainA_entry_time_fraction",
      "measure": "entry_time",
      "scope": {
        "train": "A"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "entry_time"
      },
      "factor": 0.1
    }
  ],
  "note": "Ensure train A's total entry time is at most 10% of the total entry time of all trains."
}