{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "rules": [
    {
      "name": "E_finish_at_least_2x_C_finish",
      "measure": "finish_time",
      "scope": {
        "train": "E"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "finish_time",
        "scope": {
          "train": "C"
        }
      },
      "factor": 2.0
    },
    {
      "name": "B_entry_time_at_most_5_percent_of_total",
      "measure": "entry_time",
      "scope": {
        "train": "B"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "entry_time",
        "scope": {}
      },
      "factor": 0.05
    }
  ],
  "note": "Constraints: E's arrival time ≥ 2×C's arrival time; B's total entry time ≤ 5% of all trains' entry time."
}