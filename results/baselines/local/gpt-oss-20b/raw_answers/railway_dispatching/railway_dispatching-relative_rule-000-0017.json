{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "rules": [
    {
      "name": "arrival_vs_entry_ratio",
      "measure": "finish_time",
      "scope": {
        "train": ["A", "B", "C", "D", "E", "F"]
      },
      "sense": "<=",
      "relative_to": {
        "measure": "entry_time",
        "scope": {
          "train": ["A", "B", "C", "D", "E", "F"]
        }
      },
      "factor": 0.25
    }
  ],
  "note": "Total arrival time at destination must be at most 25% of total entry time."
}