{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "rules": [
    {
      "name": "resource3_at_least_3_times_resource2",
      "measure": "entry_time",
      "scope": {
        "resource": 3
      },
      "sense": ">=",
      "relative_to": {
        "measure": "entry_time",
        "scope": {
