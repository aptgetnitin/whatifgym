{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "logic": [
    {
      "name": "start_time_Baden_Baden_implies_lateness_Customer5",
      "at_least": 1,
      "of": [
        {
          "measure": "start_time",
          "scope": {
            "location": "Baden-Baden"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "lateness",
          "scope": {
            "customer": "Customer5"
          },
          "sense": ">=",
          "value": 130
        }
      ]
    }
  ]
}