{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "rules": [
    {
      "name": "unfilled_at_least_3x_assigned",
      "measure": "unfilled",
      "sense": ">=",
      "relative_to": {
        "measure": "assign"
      },
      "factor": 3
    }
  ],
  "note": "Total unfilled jobs must be at least 3 times total assigned jobs."
}