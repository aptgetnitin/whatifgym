{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "data_changes": [
    {
      "op": "scale",
      "table": "travel_times",
      "column": "travel_min",
      "where": {
        "from_location": [
          "Heidelberg",
          "Freiburg im Breisgau",
          "Mannheim",
          "Karlsruhe",
          "Baden-Baden",
          "Buehl",
          "Offenburg",
          "Lahr/Schwarzwald"
        ]
      },
      "factor": 0.9
    },
    {
      "op": "set",
      "table": "job_types",
      "column": "priority",
      "where": {
        "job_type": "Repair - Urgent"
      },
      "value": 2
    }
  ],
  "note": "Reduce travel times by 10% and set priority of Repair - Urgent to 2."
}