{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "data_changes": [
    {
      "op": "scale",
      "table": "job_types",
      "column": "duration_min",
      "where": {
        "job_type": [
          "Equipment Installation",
          "Equipment Setup",
          "Inspect/Service Equipment",
          "Repair - Regular",
          "Repair - Important",
          "Repair - Urgent",
          "Repair - Critical"
        ]
      },
      "factor": 0.8
    }
  ],
  "rules": [
    {
      "measure": "lateness",
      "scope": {},
      "sense": "<=",
      "value": 90,
      "name": "cap_lateness_total"
    }
  ],
  "note": "Job durations reduced by 20% and total lateness capped at 90."
}