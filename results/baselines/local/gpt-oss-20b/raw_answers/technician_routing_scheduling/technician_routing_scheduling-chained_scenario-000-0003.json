{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "data_changes": [
    {
      "op": "scale",
      "table": "job_types",
      "column": "priority",
      "where": {
        "job_type": [
          "Equipment Installation",
          "Equipment Setup",
          "Inspect/Service Equipment",
          "Repair - Regular",
          "Repair - Important",
          "Repair - Urgent",
          "Repair - Critical"
        ]
      },
      "factor": 0.75
    }
  ],
  "rules": [
    {
      "measure": "route",
      "scope": {},
      "sense": "<=",
      "value": 6,
      "name": "cap_route_total"
    }
  ],
  "note": "All job priorities reduced by 25%."
}