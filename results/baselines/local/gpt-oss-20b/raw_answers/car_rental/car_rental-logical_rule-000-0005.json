{
  "version": "0.1",
  "base_model": "car_rental",
  "logic": [
    {
      "name": "no_both_monday_wednesday_repairs",
      "at_least": 1,
      "of": [
        {
          "measure": "repairs",
          "scope": {
            "day": "Monday"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "repairs",
          "scope": {
            "day": "Wednesday"
          },
          "sense": "<=",
          "value": 0
        }
      ]
    }
  ],
  "note": "Ensure that Monday and Wednesday cannot both have repairs."
}