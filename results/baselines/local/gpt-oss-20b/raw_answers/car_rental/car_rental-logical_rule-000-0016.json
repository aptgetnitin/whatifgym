{
  "version": "0.1",
  "base_model": "car_rental",
  "logic": [
    {
      "name": "at_most_one_day_nonzero_rentals",
      "at_least": 2,
      "of": [
        {
          "measure": "rentals",
          "scope": { "day": "Wednesday" },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "rentals",
          "scope": { "day": "Thursday" },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "rentals",
          "scope": { "day": "Saturday" },
          "sense": "==",
          "value": 0
        }
      ]
    }
  ],
  "note": "At least two of Wednesday, Thursday, Saturday must have zero rentals, so at most one day can have non‑zero rentals."
}