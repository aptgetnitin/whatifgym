{
  "version": "0.1",
  "base_model": "car_rental",
  "logic": [
    {
      "name": "no_nonzero_repairs_both_days",
      "at_least": 1,
      "of": [
        {
          "measure": "repairs",
          "scope": {
            "day": "Tuesday"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "repairs",
          "scope": {
            "day": "Saturday"
          },
          "sense": "<=",
          "value": 0
        }
      ]
    }
  ],
  "note": "Ensure that at least one of Tuesday or Saturday has zero repairs."
}