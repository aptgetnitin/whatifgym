{
  "version": "0.1",
  "base_model": "car_rental",
  "logic": [
    {
      "name": "repair_requires_undamaged",
      "at_least": 1,
      "of": [
        {
          "measure": "repairs",
          "scope": {
            "day": "Friday",
            "depot": "Birmingham"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "undamaged_stock",
          "scope": {
            "day": "Friday",
            "depot": "Birmingham"
          },
          "sense": ">=",
          "value": 160
        }
      ]
    }
  ]
}