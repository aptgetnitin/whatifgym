{
  "version": "0.1",
  "base_model": "food_manufacture",
  "rules": [
    {
      "name": "May_at_least_double_Feb",
      "measure": "consume",
      "scope": {
        "month": "May"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "consume",
        "scope": {
          "month": "Feb"
        }
      },
      "factor": 2.0
    }
  ],
  "note": "Ensure total refined oil in May is at least twice the total refined oil in February."
}