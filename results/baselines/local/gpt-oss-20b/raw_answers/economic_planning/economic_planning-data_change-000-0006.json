{
  "version": "0.1",
  "base_model": "economic_planning",
  "data_changes": [
    {
      "op": "set",
      "table": "industries",
      "column": "initial_stock",
      "where": {
        "industry": "coal"
      },
      "value": 500
    },
    {
      "op": "scale",
      "table": "input_output",
      "column": "input_per_unit_capacity",
      "where": {
        "supplier": "coal",
        "user": "transport"
      },
      "factor": 1.25
    }
  ],
  "note": "Set coal initial stock to 500 and increase coal input per unit capacity for transport by 25%."
}