{
  "version": "0.1",
  "base_model": "drone_network",
  "rules": [
    {
      "name": "linked_load_ratio",
      "measure": "linked_load",
      "scope": {
        "base": "800 VIRGINIA BEACH BLVD Fire Station"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "linked_load",
        "scope": {
          "base": "5145 RURITAN COURT Rescue Squad"
        }
      },
      "factor": 3.0
    },
    {
      "name": "open_base_fraction",
      "measure": "open",
      "scope": {
        "base": "5145 RURITAN COURT Rescue Squad"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "open",
        "scope": {}
      },
      "factor": 0.3
    }
  ],
  "note": "Ensure linked load at 800 is at least 3× that at 5145, and 5145 accounts for at least 30% of opened bases."
}