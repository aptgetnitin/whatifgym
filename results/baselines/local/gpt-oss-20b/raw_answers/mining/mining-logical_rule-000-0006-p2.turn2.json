{
  "version": "0.1",
  "base_model": "mining",
  "logic": [
    {
      "name": "Year1_Year2_non_overlapping_blend",
      "at_least": 1,
      "of": [
        {
          "measure": "blend",
          "scope": { "year": "Year1" },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "blend",
          "scope": { "year": "Year2" },
          "sense": "<=",
          "value": 0
        }
      ]
    }
  ]
}