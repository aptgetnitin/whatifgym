{
  "version": "0.1",
  "base_model": "power_generation_hydro",
  "data_changes": [
    {
      "op": "set",
      "table": "thermal_types",
      "column": "cost_per_hour",
      "where": {
        "type": "Thermal0"
      },
      "value": 1500
    },
    {
      "op": "scale",
      "table": "hydro_units",
      "column": "startup_cost",
      "where": {
        "hydro": "HydroA"
      },
      "factor": 1.10
    }
  ],
  "note": "Updated Thermal0 running cost to $1500 per hour and increased HydroA startup cost by 10%."
}