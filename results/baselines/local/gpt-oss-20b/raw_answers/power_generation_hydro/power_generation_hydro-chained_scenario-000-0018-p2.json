{
  "version": "0.1",
  "base_model": "power_generation_hydro",
  "data_changes": [
    {
      "op": "scale",
      "table": "thermal_types",
      "column": "cost_per_mwh_above_min",
      "where": {
        "type": "Thermal0"
      },
      "factor": 0.75
    },
    {
      "op": "set_param",
      "name": "reserve_margin",
      "value": 0.11
    }
  ],
  "note": "Reserve margin set to 0.11, keeping the earlier cost scaling for Thermal0."
}