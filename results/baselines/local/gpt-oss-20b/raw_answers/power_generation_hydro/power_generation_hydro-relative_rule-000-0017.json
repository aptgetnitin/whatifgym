{
  "version": "0.1",
  "base_model": "power_generation_hydro",
  "rules": [
    {
      "name": "reservoir_75pct_15-18",
      "measure": "reservoir_level",
      "scope": {
        "period": "15-18"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "reservoir_level",
        "scope": {
          "period": "18-24"
        }
      },
      "factor": 0.75
    },
    {
      "name": "nstart_00-06_vs_15-18",
      "measure": "nstart",
      "scope": {
        "period": "00-06"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "nstart",
        "scope": {
          "period": "15-18"
        }
      },
      "factor": 0.6
    }
  ],
  "note": "At least 75% of the reservoir level at the end of period 15-18 must be present, and the number of thermal units started in 00-06 must be at most 60% of those started in 15-18."
}