{
  "version": "0.1",
  "base_model": "factory_planning",
  "logic": [
    {
      "name": "no_sales_both_feb_may",
      "at_least": 1,
      "of": [
        {
          "measure": "sell",
          "scope": { "month": "Feb" },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "sell",
          "scope": { "month": "May" },
          "sense": "==",
          "value": 0
        }
      ]
    }
  ],
  "note": "Ensure that at least one of February or May has zero sales."
}