{
  "version": "0.1",
  "base_model": "factory_planning",
  "logic": [
    {
      "name": "no_both_prod3_and_prod4_sold",
      "at_least": 1,
      "of": [
        {
          "measure": "sell",
          "scope": {
            "product": "Prod3"
          },
          "sense": "<=",
          "value": 0
        },
        {
          "measure": "sell",
          "scope": {
            "product": "Prod4"
          },
          "sense": "<=",
          "value": 0
        }
      ]
    }
  ],
  "note": "At least one of Prod3 or Prod4 must have zero sales."
}