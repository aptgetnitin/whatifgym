{
  "version": "0.1",
  "base_model": "car_rental",
  "data_changes": [
    {
      "op": "scale",
      "table": "rental_lengths",
      "column": "price_same_depot",
      "where": {
        "rental_days": 2
      },
      "factor": 0.8
    },
    {
      "op": "set",
      "table": "demand",
      "column": "demand",
      "where": {
        "day": "Friday",
        "depot": "Birmingham"
      },
      "value": 35
    }
  ]
}