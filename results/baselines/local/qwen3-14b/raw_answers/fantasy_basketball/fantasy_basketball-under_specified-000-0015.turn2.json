{
  "version": "0.1",
  "base_model": "fantasy_basketball",
  "data_changes": [
    {
      "op": "scale",
      "table": "players",
      "column": "salary",
      "where": {
        "position": [
          "PG",
          "SG",
          "SF",
          "PF",
          "C"
        ]
      },
      "factor": 1.2
    }
  ],
  "note": "Scaling all player salaries by 20% across all positions."
}