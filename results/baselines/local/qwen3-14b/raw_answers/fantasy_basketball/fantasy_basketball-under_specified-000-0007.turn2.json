{
  "version": "0.1",
  "base_model": "fantasy_basketball",
  "data_changes": [
    {
      "op": "scale",
      "table": "players",
      "column": "salary",
      "where": {
        "player": {
          "position": [
            "PG",
            "SG",
            "SF",
            "PF",
            "C"
          ]
        }
      },
      "factor": 0.75
    }
  ],
  "note": "Player salaries are scaled down by 25% across all positions."
}