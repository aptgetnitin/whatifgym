{
  "version": "0.1",
  "base_model": "food_supply",
  "rules": [
    {
      "name": "total_food_bought_vs_shipped",
      "measure": "purchase",
      "scope": {
        "food": "all",
        "supplier": "all"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "flow",
        "scope": {
          "food": "all",
          "from_city": "all",
          "to_city": "all"
        }
      },
      "factor": 3.0
    }
  ]
}