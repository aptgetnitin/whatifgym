{
 "version": "0.1",
 "base_model": "food_supply",
 "data_changes": [
  {
   "op": "scale",
   "table": "foods",
   "column": "international_price",
   "factor": 1.25
  },
  {
   "op": "scale_param",
   "name": "min_per_person",
   "factor": 1.2,
   "where": {
    "nutrient": "Protein(g)"
   }
  }
 ],
 "note": "International prices are scaled by 25% and the minimum daily intake for protein is increased by 20%."
}