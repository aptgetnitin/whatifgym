{
  "version": "0.1",
  "base_model": "factory_planning",
  "logic": [
    {
      "name": "non_zero_sales_in_may_or_feb",
      "at_least": 1,
      "of": [
        {
          "measure": "sell",
          "scope": {
            "month": "May",
            "product": {
              "$wildcard": true
            }
          },
          "sense": ">=",
          "value": 0.0001
        },
        {
          "measure": "sell",
          "scope": {
            "month": "Feb",
            "product": {
              "$wildcard": true
            }
          },
          "sense": ">=",
          "value": 0.0001
        }
      ]
    }
  ]
}