{
  "version": "0.1",
  "base_model": "factory_planning",
  "data_changes": [
    {
      "op": "scale",
      "table": "max_sales",
      "column": "max_sales",
      "where": {
        "product": "Prod4",
        "month": "Jan"
      },
      "factor": 1.1
    },
    {
      "op": "scale_param",
      "name": "profit_per_unit",
      "factor": 1.25,
      "where": {
        "product": "Prod3"
      }
    }
  ],
  "note": "Scaling max_sales for Prod4 in January by 1.1 and scaling profit_per_unit for Prod3 by 1.25."
}