{
  "version": "0.1",
  "base_model": "factory_planning",
  "data_changes": [
    {
      "op": "scale",
      "table": "max_sales",
      "column": "max_sales",
      "where": {
        "product": "Prod1",
        "month": [
          "Jan",
          "Feb",
          "Mar"
        ]
      },
      "factor": 1.3
    }
  ],
  "note": "A 30% increase in the market limit for Prod1 in Jan, Feb, and Mar is modeled by scaling the max_sales values for those months."
}