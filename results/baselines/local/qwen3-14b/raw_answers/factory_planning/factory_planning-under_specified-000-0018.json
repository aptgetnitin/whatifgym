{
  "version": "0.1",
  "base_model": "factory_planning",
  "rules": [
    {
      "name": "stock_cap",
      "measure": "store",
      "scope": {
        "month": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ],
        "product": [
          "Prod1",
          "Prod2",
          "Prod3",
          "Prod4",
          "Prod5",
          "Prod6",
          "Prod7"
        ]
      },
      "sense": "<=",
      "value": 150
    }
  ],
  "note": "A cap on the units in stock is implemented as a rule limiting the sum of the store measure across all months and products to 150 units."
}