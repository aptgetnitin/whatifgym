{
  "version": "0.1",
  "base_model": "manpower_planning",
  "logic": [
    {
      "name": "non_zero_overmanned_in_year1_or_year3",
      "at_least": 1,
      "of": [
        {
          "measure": "overmanned",
          "scope": {
            "year": 1,
            "skill": {
              "enum": ["unskilled", "semi_skilled", "skilled"]
            }
          },
          "sense": ">=",
          "value": 1
        },
        {
          "measure": "overmanned",
          "scope": {
            "year": 3,
            "skill": {
              "enum": ["unskilled", "semi_skilled", "skilled"]
            }
          },
          "sense": ">=",
          "value": 1
        }
      ]
    }
  ]
}