{
  "version": "0.1",
  "base_model": "single_machine_scheduling",
  "data_changes": [
    {
      "op": "scale",
      "table": "jobs",
      "column": "duration",
      "where": {
        "job": [
          "job_0",
          "job_1",
          "job_2",
          "job_3",
          "job_4",
          "job_5",
          "job_6",
          "job_7",
          "job_8",
          "job_9",
          "job_10",
          "job_11",
          "job_12",
          "job_13",
          "job_14"
        ]
      },
      "factor": 0.8
    },
    {
      "op": "scale",
      "table": "setup_times",
      "column": "setup_time",
      "where": {
        "from_job": "job_8",
        "to_job": "job_7"
      },
      "factor": 0.5
    }
  ]
}