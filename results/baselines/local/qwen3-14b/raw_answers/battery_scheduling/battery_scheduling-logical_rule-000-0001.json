{
  "version": "0.1",
  "base_model": "battery_scheduling",
  "rules": [
    {
      "name": "soc_10_11_zero_or_min",
      "measure": "soc",
      "scope": {
        "hour": "10-11"
      },
      "sense": ">=",
      "value": 40
    }
  ],
  "logic": [
    {
      "name": "soc_10_11_zero_or_min_logic",
      "at_least": 1,
      "of": [
        {
          "measure": "soc",
          "scope": {
            "hour": "10-11"
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "soc",
          "scope": {
            "hour": "10-11"
          },
          "sense": ">=",
          "value": 40
        }
      ]
    }
  ]
}