{
  "version": "0.1",
  "base_model": "battery_scheduling",
  "logic": [
    {
      "name": "soc_nonzero_in_one_hour",
      "at_least": 1,
      "of": [
        {
          "measure": "soc",
          "scope": {
            "hour": "22-23"
          },
          "sense": ">=",
          "value": 0.0001
        },
        {
          "measure": "soc",
          "scope": {
            "hour": "07-08"
          },
          "sense": ">=",
          "value": 0.0001
        },
        {
          "measure": "soc",
          "scope": {
            "hour": "11-12"
          },
          "sense": ">=",
          "value": 0.0001
        }
      ]
    }
  ]
}