{
  "version": "0.1",
  "base_model": "car_rental",
  "data_changes": [
    {
      "op": "scale",
      "table": "transfer_costs",
      "column": "cost",
      "where": {
        "from_depot": "Glasgow",
        "to_depot": "Birmingham"
      },
      "factor": 1.2
    }
  ],
  "note": "Scaling the transfer cost for Glasgow to Birmingham by 20%."
}