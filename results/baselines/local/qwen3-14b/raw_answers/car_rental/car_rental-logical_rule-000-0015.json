{
  "version": "0.1",
  "base_model": "car_rental",
  "logic": [
    {
      "name": "birmingham_repair_either_zero_or_300",
      "at_least": 1,
      "of": [
        {
          "measure": "repairs",
          "scope": {
            "depot": "Birmingham"
          },
          "sense": "==",
