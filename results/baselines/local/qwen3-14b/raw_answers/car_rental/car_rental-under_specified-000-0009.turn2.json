{
  "version": "0.1",
  "base_model": "car_rental",
  "data_changes": [
    {
      "op": "scale",
      "table": "rental_lengths",
      "column": "marginal_cost",
      "where": {
        "rental_days": 1
      },
      "factor": 0.9
    }
  ],
  "note": "The marginal cost per rental for rental length 1 is scaled by 90% (a 10% decrease)."
}