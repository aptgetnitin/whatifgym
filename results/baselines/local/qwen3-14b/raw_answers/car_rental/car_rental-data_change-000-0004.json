{
  "version": "0.1",
  "base_model": "car_rental",
  "data_changes": [
    {
      "op": "scale",
      "table": "transfer_costs",
      "column": "cost",
      "where": {
        "from_depot": "Manchester",
        "to_depot": "Glasgow"
      },
      "factor": 1.2
    },
    {
      "op": "scale_param",
      "name": "repair_capacity",
      "factor": 1.25
    }
  ]
}