{
  "version": "0.1",
  "base_model": "food_manufacture",
  "rules": [
    {
      "name": "min_batch_oil1_mar",
      "measure": "store",
      "scope": {
        "month": "Mar",
        "oil": "OIL1"
      },
      "sense": ">=",
      "value": 750
    }
  ],
  "logic": [
    {
      "name": "either_zero_or_min_batch",
      "at_least": 1,
      "of": [
        {
          "measure": "store",
          "scope": {
            "month": "Mar",
            "oil": "OIL1"
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "store",
          "scope": {
            "month": "Mar",
            "oil": "OIL1"
          },
          "sense": ">=",
          "value": 750
        }
      ]
    }
  ]
}