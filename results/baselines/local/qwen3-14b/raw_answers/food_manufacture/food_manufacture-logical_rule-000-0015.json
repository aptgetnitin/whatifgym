{
  "version": "0.1",
  "base_model": "food_manufacture",
  "rules": [
    {
      "name": "veg2_storage_feb",
      "measure": "store",
      "scope": {
        "month": "Feb",
        "oil": "VEG2"
      },
      "sense": ">=",
      "value": 560
    }
  ],
  "logic": [
    {
      "name": "veg2_storage_feb_either_zero_or_560",
      "at_least": 1,
      "of": [
        {
          "measure": "store",
          "scope": {
            "month": "Feb",
            "oil": "VEG2"
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "store",
          "scope": {
            "month": "Feb",
            "oil": "VEG2"
          },
          "sense": ">=",
          "value": 560
        }
      ]
    }
  ]
}