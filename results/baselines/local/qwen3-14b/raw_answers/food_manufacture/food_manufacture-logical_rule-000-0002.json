{
  "version": "0.1",
  "base_model": "food_manufacture",
  "logic": [
    {
      "name": "storage_condition_apr_may",
      "at_least": 1,
      "of": [
        {
          "measure": "consume",
          "scope": {
            "month": "Apr"
          },
          "sense": ">=",
          "value": 0
        },
        {
          "measure": "store",
          "scope": {
            "month": "May"
          },
          "sense": ">=",
          "value": 2000
        }
      ]
    }
  ]
}