{
  "version": "0.1",
  "base_model": "mining",
  "rules": [
    {
      "name": "open_years_limit",
      "measure": "open",
      "scope": {
        "year": ["Year1", "Year2", "Year3", "Year4", "Year5"],
        "mine": ["Mine1", "Mine2", "Mine3", "Mine4"]
      },
      "sense": "<=",
      "relative_to": {
        "measure": "operate",
        "scope": {
          "year": ["Year1", "Year2", "Year3", "Year4", "Year5"],
          "mine": ["Mine1", "Mine2", "Mine3", "Mine4"]
        }
      },
      "factor": 0.5
    },
    {
      "name": "year1_blend_vs_year3_blend",
      "measure": "blend",
      "scope": {
        "year": "Year1"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "blend",
        "scope": {
          "year": "Year3"
        }
      },
      "factor": 2.0
    }
  ]
}