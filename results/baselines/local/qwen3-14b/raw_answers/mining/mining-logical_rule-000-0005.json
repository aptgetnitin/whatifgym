{
  "version": "0.1",
  "base_model": "mining",
  "rules": [
    {
      "name": "year1_extract_rule",
      "measure": "extract",
      "scope": {
        "year": "Year1"
      },
      "sense": ">=",
      "value": 8625000
    }
  ],
  "logic": [
    {
      "name": "year1_extract_either_zero_or_min",
      "at_least": 1,
      "of": [
        {
          "measure": "extract",
          "scope": {
            "year": "Year1"
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "extract",
          "scope": {
            "year": "Year1"
          },
          "sense": ">=",
          "value": 8625000
        }
      ]
    }
  ]
}