{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "rules": [
    {
      "name": "other_train_e_clearing_resource",
      "measure": "goes_first",
      "scope": {
        "resource": "resource",
        "other_train": "E"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "goes_first",
        "scope": {
          "resource": "resource"
        }
      },
      "factor": 0.2
    },
    {
      "name": "train_d_meet_pairs",
      "measure": "meet",
      "scope": {
        "resource": "resource",
        "train": "D"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "meet",
        "scope": {
          "resource": "resource",
          "train": "B"
        }
      },
      "factor": 1.5
    }
  ]
}