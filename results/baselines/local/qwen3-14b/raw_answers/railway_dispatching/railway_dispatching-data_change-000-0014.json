{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "data_changes": [
    {
      "op": "scale",
      "table": "resources",
      "column": "duration",
      "where": {
        "kind": [
          "station",
          "track"
        ]
      },
      "factor": 1.2
    },
    {
      "op": "remove",
      "table": "trains",
      "where": {
        "train": "B"
      }
    }
  ]
}