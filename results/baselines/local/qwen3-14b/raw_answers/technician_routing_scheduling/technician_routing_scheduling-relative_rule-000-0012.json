{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "rules": [
    {
      "name": "flor_dispatched_percentage",
      "measure": "use",
      "scope": {
        "technician": "Flor"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "use",
        "scope": {}
      },
      "factor": 0.75
    },
    {
      "name": "assigned_jobs_percentage",
      "measure": "assign",
      "scope": {},
      "sense": "<=",
      "relative_to": {
        "measure": "unfilled",
        "scope": {}
      },
      "factor": 0.75
    }
  ]
}