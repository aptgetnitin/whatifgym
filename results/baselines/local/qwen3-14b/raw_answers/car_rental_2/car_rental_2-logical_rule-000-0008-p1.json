{
  "version": "0.1",
  "base_model": "car_rental_2",
  "logic": [
    {
      "name": "damaged_transfer_to_manchester_rule",
      "at_least": 1,
      "of": [
        {
          "measure": "damaged_transfers",
          "scope": {
            "day": "Wednesday",
            "from_depot": "Glasgow",
            "to_depot": "Manchester"
          },
          "sense": ">=",
          "value": 1
        },
        {
          "measure": "undamaged_transfers",
          "scope": {
            "day": "Wednesday",
            "to_depot": "Manchester"
          },
          "sense": ">=",
          "value": 78
        }
      ]
    }
  ]
}