{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "data_changes": [
    {
      "op": "scale",
      "table": "counties",
      "column": "demand",
      "where": {
        "county": [
          "C1",
          "C2",
          "C3",
          "C4",
          "C5",
          "C6",
          "C7",
          "C8",
          "C9"
        ]
      },
      "factor": 0.75
    }
  ],
  "note": "A 25% reduction in demand for all counties is modeled by scaling the 'demand' column in the 'counties' table by a factor of 0.75."
}