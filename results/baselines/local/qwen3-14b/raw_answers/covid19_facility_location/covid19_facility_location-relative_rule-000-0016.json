{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "temp_facility_build_percentage",
      "measure": "build",
      "scope": {
        "facility": "T17"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "build",
        "scope": {
          "kind": "temporary"
        }
      },
      "factor": 0.75
    },
    {
      "name": "facility_e12_patient_limit",
      "measure": "assign",
      "scope": {
        "facility": "E12"
      },
      "sense": "<=",
      "relative_to": {
        "measure": "assign",
        "scope": {
          "facility": "E6"
        }
      },
      "factor": 1.0
    }
  ]
}