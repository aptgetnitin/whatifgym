{
  "version": "0.1",
  "base_model": "car_rental_2",
  "data_changes": [
    {
      "op": "scale",
      "table": "rental_lengths",
      "column": "price_other_depot",
      "where": {
        "rental_days": [
          1,
          2,
          3
        ]
      },
      "factor": 0.5
    },
    {
      "op": "scale",
      "table": "return_shares",
      "column": "share",
      "where": {
        "from_depot": [
          "Glasgow",
          "Manchester",
          "Birmingham",
          "Plymouth"
        ],
        "to_depot": [
          "Glasgow",
          "Manchester",
          "Birmingham",
          "Plymouth"
        ]
      },
      "factor": 0.5
    }
  ]
}