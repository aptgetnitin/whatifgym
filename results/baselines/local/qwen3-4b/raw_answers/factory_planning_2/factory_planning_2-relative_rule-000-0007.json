{
  "version": "0.1",
  "base_model": "factory_planning_2",
  "rules": [
    {
      "name": "may_units_at_least_50_percent",
      "measure": "make",
      "scope": {
        "month": "May"
      },
      "sense": ">=",
      "value": 0.5
    },
    {
      "name": "feb_sales_at_least_1_5x_jan_sales",
      "measure": "sell",
      "scope": {
        "month": "Feb"
      },
      "sense": ">=",
      "relative_to": {
        "measure": "sell",
        "scope": {
          "month": "Jan"
        }
      },
      "factor": 1.5
    }
  ]
}