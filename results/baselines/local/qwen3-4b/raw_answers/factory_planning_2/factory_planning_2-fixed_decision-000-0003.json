{
  "version": "0.1",
  "base_model": "factory_planning_2",
  "data_changes": [
    {
      "op": "set",
      "table": "max_sales",
      "column": "max_sales",
      "where": {
        "product": [
          "Prod1",
          "Prod2",
          "Prod3",
          "Prod4",
          "Prod5",
          "Prod6",
          "Prod7"
        ],
        "month": [
          "Mar"
        ]
      },
      "value": 140
    }
  ],
  "note": "The planner wants each product to have exactly 140 units sold in March, so we set the max_sales for all products in March to 140."
