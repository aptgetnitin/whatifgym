{
  "version": "0.1",
  "base_model": "factory_planning_2",
  "rules": [
    {
      "name": "at_most_one_month_sales",
      "measure": "sell",
      "scope": {
        "month": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May"
        ]
      },
      "sense": "<=",
      "value": 1
    }
  ],
  "note": "The rule ensures that the total sales across the specified months do not exceed 1 unit."
}