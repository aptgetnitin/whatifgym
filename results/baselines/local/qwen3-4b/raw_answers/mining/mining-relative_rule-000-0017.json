{
  "version": "0.1",
  "base_model": "mining",
  "rules": [
    {
      "name": "mine_years_open_below_50_worked",
      "measure": "open",
      "scope": {
        "year": [
          "Year1",
          "Year2",
          "Year3",
          "Year4",
          "Year5"
        ]
      },
      "sense": "<=",
      "value": 0.5,
      "relative_to": {
        "measure": "operate",
        "scope": {
          "year": [
            "Year1",
            "Year2",
            "Year3",
            "Year4",
            "Year5"
          ]
        }
      },
      "factor": 0.5
    },
    {
      "name": "blend_year1_at_least_2x_year3",
      "measure": "blend",
      "scope": {
        "year": "Year1"
      },
      "sense": ">=",
      "value": 2,
      "relative_to": {
        "measure": "blend",
        "scope": {
          "year": "Year3"
        }
      }
    }
  ]
}