{
  "version": "0.1",
  "base_model": "mining",
  "data_changes": [
    {
      "op": "relax",
      "table": "years",
      "column": "quality_target",
      "where": {
        "year": [
          "Year1",
          "Year2",
          "Year3",
          "Year4",
          "Year5"
        ]
      },
      "factor": 1.0
    }
  ],
  "note": "The blend-quality target is a constraint in the model, so relaxing it means removing the quality constraint for all years."
}