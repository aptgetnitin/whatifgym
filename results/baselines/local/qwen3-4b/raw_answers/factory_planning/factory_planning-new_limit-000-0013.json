{
  "version": "0.1",
  "base_model": "factory_planning",
  "data_changes": [
    {
      "op": "set",
      "table": "max_sales",
      "column": "max_sales",
      "where": {
        "product": "Prod5",
        "month": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ]
      },
      "value": 1950
    }
  ],
  "note": "The supplier constraint limits total production of Prod5 to 1950 units, so we set the max_sales for Prod5 across all months to 1950."
}