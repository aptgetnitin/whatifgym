{
  "version": "0.1",
  "base_model": "railway_dispatching",
  "objective": [
    {
      "sense": "min",
      "measure": "original"
    }
  ],
  "data_changes": [
    {
      "op": "set",
      "table": "trains",
      "column": "ready_time",
      "where": {
        "train": "C"
      },
      "value": "2 * ready_time[C]"
    }
  ]
}