{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "data_changes": [
    {
      "op": "scale",
      "table": "travel_times",
      "column": "travel_min",
      "where": {
        "from_location": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "to_location": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "factor": 1.2
    }
  ]
}