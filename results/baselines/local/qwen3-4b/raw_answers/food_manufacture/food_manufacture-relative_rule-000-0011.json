{
  "version": "0.1",
  "base_model": "food_manufacture",
  "data_changes": [
    {
      "op": "scale",
      "table": "purchase_prices",
      "column": "buy",
      "where": {
        "month": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ],
        "oil": [
          "VEG1",
          "VEG2",
          "OIL1",
          "OIL2",
          "OIL3"
        ]
      },
      "factor": 1.25
    }
  ],
  "note": "The total tons of oil refined may be at least 1.25 times the total tons of oil bought. This is a constraint on the relationship between the buy and consume variables."
}