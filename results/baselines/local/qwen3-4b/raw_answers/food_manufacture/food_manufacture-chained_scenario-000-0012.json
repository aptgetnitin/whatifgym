{
  "version": "0.1",
  "base_model": "food_manufacture",
  "data_changes": [
    {
      "op": "scale",
      "table": "params",
      "column": "initial_stock",
      "where": {
        "oil": [
          "VEG1",
          "VEG2",
          "OIL1",
          "OIL2",
          "OIL3"
        ]
      },
      "factor": 1.5
    }
  ],
  "note": "The opening stock per oil changes by a factor of 1.5, so we scale the initial_stock parameter for all oils by 1.5."
}