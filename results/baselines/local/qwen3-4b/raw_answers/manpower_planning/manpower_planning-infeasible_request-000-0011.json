{
  "version": "0.1",
  "base_model": "manpower_planning",
  "data_changes": [
    {
      "op": "set",
      "table": "retrain",
      "column": "retrain",
      "where": {
        "year": 1,
        "from_skill": [
          "unskilled",
          "semi_skilled"
        ],
        "to_skill": [
          "semi_skilled",
          "skilled"
        ]
      },
      "value": 680
    },
    {
      "op": "set",
      "table": "retrain",
      "column": "retrain",
      "where": {
        "year": 3,
        "from_skill": [
          "unskilled",
          "semi_skilled"
        ],
        "to_skill": [
          "semi_skilled",
          "skilled"
        ]
      },
      "value": 460
    }
  ],
  "note": "The planner asks for minimum retraining levels per year and skill level, but the model's retrain measure is defined per year, from_skill, to_skill. The question specifies a total retrain count for year 1 and year 3 across all skill levels, so we set the total retrain for those years."
}