      "scope": {
        "year": 2,
        "skill": "unskilled"
      },
      "sense": ">=",
      "value": 210
    },
    {
      "name": "downgrade_from_skilled_to_semi_skilled_year1",
      "measure": "downgrade",
      "scope": {
        "year": 1,
        "from_skill": "skilled",
        "to_skill": "semi_skilled"
      },
      "sense": ">=",
      "value": 210
    }
  ]
}