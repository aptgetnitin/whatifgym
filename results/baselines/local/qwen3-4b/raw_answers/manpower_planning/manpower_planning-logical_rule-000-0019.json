{
  "version": "0.1",
  "base_model": "manpower_planning",
  "data_changes": [
    {
      "op": "set",
      "table": "requirements",
      "column": "required",
      "where": {
        "year": 2,
        "skill": "unskilled"
      },
      "value": 0
    }
  ],
  "rules": [
    {
      "name": "unskilled_overmanned_year2",
