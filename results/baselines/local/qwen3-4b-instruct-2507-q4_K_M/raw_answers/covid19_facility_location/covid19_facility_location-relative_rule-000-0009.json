{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "e4_at_least_15_times_e1",
      "measure": "assign",
      "scope": {
        "facility": "E4"
      },
      "sense": ">=",
      "value": 1.5,
      "relative_to": {
        "measure": "assign",
        "scope": {
          "facility": "E1"
        }
      },
      "factor": 1.0
    }
  ],
  "note": "The patients assigned to facility E4 must be at least 1.5 times the patients assigned to facility E1."
}