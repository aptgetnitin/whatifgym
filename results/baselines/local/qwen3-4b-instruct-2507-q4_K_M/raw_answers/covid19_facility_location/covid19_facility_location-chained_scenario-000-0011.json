{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "data_changes": [
    {
      "op": "scale",
      "table": "counties",
      "column": "demand",
      "where": {
        "county": "C2"
      },
      "factor": 0.9
    },
    {
      "op": "scale",
      "table": "facilities",
      "column": "capacity",
      "where": {
        "facility": "T17"
      },
      "factor": 1.1
    }
  ],
  "note": "Demand for county C2 is reduced by 10% and capacity of facility T17 is increased by 10% as per the original and new conditions."
}