{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "e1_e9_assignment_constraint",
      "measure": "assign",
      "scope": {
        "facility": "E1"
      },
      "sense": ">=",
      "value": 0
    },
    {
      "name": "e9_minimum_assignment",
      "measure": "assign",
      "scope": {
        "facility": "E9"
      },
      "sense": ">=",
      "value": 380
    }
  ],
  "note": "Patients assigned to facility E1 must be above zero, which obliges the total patients assigned to facility E9 to be at least 380."
}