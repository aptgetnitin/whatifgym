{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "at_most_5_percent_to_e4",
      "measure": "assign",
      "scope": {
        "facility": "E4"
      },
      "sense": "<=",
      "value": 0.05,
      "relative_to": {
        "measure": "assign",
        "scope": {
          "county": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8",
            "C9"
          ]
        }
      },
      "factor": 1.0
    }
  ],
  "note": "Restricts the total patients assigned to facility E4 to at most 5% of the total patient demand across all counties."
}