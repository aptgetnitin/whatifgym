{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "T17_at_least_75_of_temporary_facilities",
      "at_least": 1,
      "of": [
        {
          "measure": "build",
          "scope": {
            "facility": "T17"
          },
          "sense": ">=",
          "value": 0.75
        },
        {
          "measure": "build",
          "scope": {
            "facility": "T17"
          },
          "sense": ">=",
          "value": 0.75
        },
        {
          "measure": "build",
          "scope": {
            "facility": "T18"
          },
          "sense": ">=",
          "value": 3.0
        }
      ]
    }
  ],
  "note": "Two relative limits: T17 must account for at least 75% of total temporary facilities built; T18 built must be at least 3 times T17 built."
}