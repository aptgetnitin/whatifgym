{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "logic": [
    {
      "name": "temp_facilities_ratio",
      "at_least": 1,
      "of": [
        {
          "measure": "build",
          "scope": {
            "facility": "T15"
          },
          "sense": "<=",
          "value": 0.9
        },
        {
          "measure": "build",
          "scope": {
            "facility": "T18"
          },
          "sense": ">=",
          "value": 0.0
        }
      ]
    }
  ],
  "note": "The number of temporary facilities built for T15 must be at most 90% of the number built for T18."
}