{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "e4_at_least_twice_e3",
      "measure": "assign",
      "scope": {
        "county": "*",
        "facility": "E4"
      },
      "sense": ">=",
      "value": 2,
      "relative_to": {
        "measure": "assign",
        "scope": {
          "county": "*",
          "facility": "E3"
        }
      },
      "factor": 1.0
    }
  ],
  "note": "The patients assigned to facility E4 must be at least twice the patients assigned to facility E3 across all counties."
}