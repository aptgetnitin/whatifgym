{
  "version": "0.1",
  "base_model": "covid19_facility_location",
  "rules": [
    {
      "name": "e11_assignment_constraint",
      "measure": "assign",
      "scope": {
        "facility": "E11"
      },
      "sense": "==",
      "value": 0
    },
    {
      "name": "e11_min_assignment_constraint",
      "measure": "assign",
      "scope": {
        "facility": "E11"
      },
      "sense": ">=",
      "value": 240
    }
  ],
  "note": "The rule enforces that either no patients are assigned to E11 or at least 240 patients are assigned, creating a binary choice in the assignment."
}