      "scope": {
        "month": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun"
        ],
        "product": [
          "Prod1",
          "Prod2",
          "Prod3",
          "Prod4",
          "Prod5",
          "Prod6",
          "Prod7"
        ]
      },
      "sense": ">=",
      "relative_to": {
        "measure": "make",
        "scope": {
          "month": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun"
          ],
          "product": [
            "Prod1",
            "Prod2",
            "Prod3",
            "Prod4",
            "Prod5",
            "Prod6",
            "Prod7"
          ]
