{
  "version": "0.1",
  "base_model": "factory_planning",
  "data_changes": [
    {
      "op": "set",
      "table": "products",
      "column": "profit_per_unit",
      "where": {
        "product": "Prod5"
      },
      "value": 25
    },
    {
      "op": "set",
      "table": "max_sales",
      "column": "max_sales",
      "where": {
        "product": "Prod3",
        "month": "Jan"
      },
      "value": 200
    }
  ],
  "note": "Prod5's profit per unit is increased by 25%, and the previous constraint on Prod3's January sales is retained."
}