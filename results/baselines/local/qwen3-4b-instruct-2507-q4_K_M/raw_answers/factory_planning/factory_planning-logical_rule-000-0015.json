{
  "version": "0.1",
  "base_model": "factory_planning",
  "logic": [
    {
      "name": "stock_feb_positive_implies_sell_jun_prod7_at_least_100",
      "at_least": 1,
      "of": [
        {
          "measure": "store",
          "scope": {
            "month": "Feb"
          },
          "sense": ">",
          "value": 0
        },
        {
          "measure": "sell",
          "scope": {
            "month": "Jun",
            "product": "Prod7"
          },
          "sense": ">=",
          "value": 100
        }
      ]
    }
  ],
  "note": "If inventory at the end of February is positive, then sales of Prod7 in June must be at least 100 units."
}