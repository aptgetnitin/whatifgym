{
  "version": "0.1",
  "base_model": "multiple_knapsack",
  "rules": [
    {
      "name": "bin4_at_least_50_percent",
      "measure": "x",
      "scope": {
        "bin": "bin4"
      },
      "sense": ">=",
      "value": 0.5,
      "relative_to": {
        "measure": "x",
        "scope": {
          "bin": [
            "bin0",
            "bin1",
            "bin2",
            "bin3",
            "bin4"
          ]
        }
      },
      "factor": 1.0
    }
  ],
  "note": "Bin4 must account for at least 50% of the total number of item placements across all bins."
}