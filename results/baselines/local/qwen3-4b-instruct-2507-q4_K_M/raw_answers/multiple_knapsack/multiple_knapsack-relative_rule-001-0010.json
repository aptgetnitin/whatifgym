{
  "version": "0.1",
  "base_model": "multiple_knapsack",
  "logic": [
    {
      "name": "item5_at_least_75_percent",
      "at_least": 1,
      "of": [
        {
          "measure": "x",
          "scope": {
            "item": "item5"
          },
          "sense": ">=",
          "value": 0.75
        },
        {
          "measure": "x",
          "scope": {
            "item": [
              "item0",
              "item1",
              "item2",
              "item3",
              "item4",
              "item5",
              "item6",
              "item7",
              "item8",
              "item9",
              "item10",
              "item11",
              "item12",
              "item13",
              "item14"
            ]
          },
          "sense": "==",
          "value": 1
        }
      ]
    }
  ],
  "note": "The total number of item placements is the sum of x over all items; item5 must be at least 75% of that sum."
}