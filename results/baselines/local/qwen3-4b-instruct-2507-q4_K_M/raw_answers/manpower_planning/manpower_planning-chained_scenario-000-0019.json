{
  "version": "0.1",
  "base_model": "manpower_planning",
  "data_changes": [
    {
      "op": "scale_param",
      "name": "short_time_productivity",
      "factor": 1.25
    },
    {
      "op": "set",
      "table": "requirements",
      "column": "required",
      "where": {
        "year": 3,
        "skill": "skilled"
      },
      "value": 2200
    },
    {
      "op": "set",
      "table": "requirements",
      "column": "required",
      "where": {
        "year": 2,
        "skill": "unskilled"
      },
      "value": 700
    },
    {
      "op": "set",
      "table": "retraining",
      "column": "max_per_year",
      "where": {
        "from_skill": "unskilled",
        "to_skill": "semi_skilled"
      },
      "value": 300
    },
    {
      "op": "set",
      "table": "retraining",
      "column": "max_share_of_target",
      "where": {
        "from_skill": "semi_skilled",
        "to_skill": "skilled"
      },
      "value": 0.2
    },
    {
      "op": "set",
      "table": "retraining",
      "column": "max_per_year",
      "where": {
        "from_skill": "unskilled",
        "to_skill": "skilled"
      },
      "value": 100
    },
    {
      "op": "scale",
      "table": "costs",
      "column": "redundancy_cost",
      "where": {
        "skill": "skilled"
      },
      "factor": 1.8
    },
    {
      "op": "scale",
      "table": "costs",
      "column": "overmanning_cost",
      "where": {
        "skill": "skilled"
      },
      "factor": 0.75
    },
    {
      "op": "add",
      "table": "years",
      "rows": [
        {
          "year": 4
        }
      ]
    },
    {
      "op": "set_param",
      "name": "downgrade_attrition",
      "value": 0.3
    },
    {
      "op": "set_param",
      "name": "max_overmanned",
      "value": 250
    },
    {
      "op": "set_param",
      "name": "max_short_time",
      "value": [100, 100, 100]
    },
    {
      "op": "set_param",
      "name": "short_time_productivity",
      "value": 0.6
    }
  ],
  "rules": [
    {
      "name": "max_skilled_recruit",
      "measure": "recruit",
      "scope": {
        "year": 1,
        "skill": "skilled"
      },
      "sense": "<=",
      "value": 700
    }
  ],
  "objective": [
    {
      "sense": "min",
      "measure": "original"
    }
  ],
  "note": "A total recruitment cap for skilled workers is introduced; other changes include updated requirements, retraining limits, costs, and parameters as specified."
}