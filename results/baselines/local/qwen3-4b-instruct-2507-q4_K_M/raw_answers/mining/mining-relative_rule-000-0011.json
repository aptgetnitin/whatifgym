{
  "version": "0.1",
  "base_model": "mining",
  "logic": [
    {
      "name": "open_at_least_1.5_times_operate",
      "at_least": 1,
      "of": [
        {
          "measure": "open",
          "scope": {
            "year": [
              "Year1",
              "Year2",
              "Year3",
              "Year4",
              "Year5"
            ],
            "mine": [
              "Mine1",
              "Mine2",
              "Mine3",
              "Mine4"
            ]
          }
        },
        {
          "measure": "operate",
          "scope": {
            "year": [
              "Year1",
              "Year2",
              "Year3",
              "Year4",
              "Year5"
            ],
            "mine": [
              "Mine1",
              "Mine2",
              "Mine3",
              "Mine4"
            ]
          }
        }
      ]
    }
  ],
  "note": "The total number of mine-years kept open must be at least 1.5 times the total number of mine-years worked, expressed as a logical rule over the sum of open and operate across all years and mines."
}