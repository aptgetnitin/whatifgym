{
  "version": "0.1",
  "base_model": "mining",
  "logic": [
    {
      "name": "open_mine_years_ratio",
      "at_least": 1,
      "of": [
        {
          "measure": "open",
          "scope": {
            "year": "Year1",
            "mine": [
              "Mine1",
              "Mine2",
              "Mine3",
              "Mine4"
            ]
          },
          "sense": "==",
          "value": 0
        },
        {
          "measure": "operate",
          "scope": {
            "year": "Year1",
            "mine": [
              "Mine1",
              "Mine2",
              "Mine3",
              "Mine4"
            ]
          },
          "sense": "==",
          "value": 0
        }
      ]
    },
    {
      "name": "blend_year1_at_least_twice_year3",
      "at_least": 1,
      "of": [
        {
          "measure": "blend",
          "scope": {
            "year": "Year1"
          },
          "sense": ">=",
          "value": 2
        },
        {
          "measure": "blend",
          "scope": {
            "year": "Year3"
          },
          "sense": "==",
          "value": 0
        }
      ]
    }
  ],
  "note": "The total number of mine-years kept open is at most 50% of the total number of mine-years worked, and blended ore sold in Year1 is at least twice that in Year3."
}