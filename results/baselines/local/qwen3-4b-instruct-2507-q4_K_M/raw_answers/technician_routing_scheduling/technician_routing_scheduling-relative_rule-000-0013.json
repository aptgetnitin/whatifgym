{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "rules": [
    {
      "name": "loerrach_start_time_limit",
      "measure": "start_time",
      "scope": {
        "location": "Loerrach"
      },
      "sense": "<=",
      "value": 0.2,
      "relative_to": {
        "measure": "start_time",
        "scope": {
          "location": [
            "Heidelberg",
            "Freiburg im Breisgau",
            "Mannheim",
            "Karlsruhe",
            "Baden-Baden",
            "Buehl",
            "Offenburg",
            "Lahr/Schwarzwald",
            "Loerrach"
          ]
        }
      },
      "factor": 1.0
    },
    {
      "name": "total_legs_at_least_three_times_dispatched",
      "measure": "route",
      "scope": {
        "from_location": [
          "Heidelberg",
          "Freiburg im Breisgau",
          "Mannheim",
          "Karlsruhe",
          "Baden-Baden",
          "Buehl",
          "Offenburg",
          "Lahr/Schwarzwald",
          "Loerrach"
        ],
        "to_location": [
          "Freiburg im Breisgau",
          "Mannheim",
          "Karlsruhe",
          "Baden-Baden",
          "Buehl",
          "Offenburg",
          "Lahr/Schwarzwald",
          "Loerrach"
        ]
      },
      "sense": ">=",
      "value": 3,
      "relative_to": {
        "measure": "use",
        "scope": {
          "technician": [
            "Albert",
            "Bob",
            "Carlos",
            "Doris",
            "Ed",
            "Flor",
            "Gina"
          ]
        }
      },
      "factor": 1.0
    }
  ],
  "note": "Loerrach's service start time is capped at 20% of total start time across all locations. Total number of legs driven must be at least three times the number of dispatched technicians."
}