{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "rules": [
    {
      "name": "lahr_schwarzwald_start_time_constraint",
      "measure": "start_time",
      "scope": {
        "location": "Lahr/Schwarzwald"
      },
      "sense": ">=",
      "value": 0
    },
    {
      "name": "lahr_schwarzwald_start_time_minimum",
      "measure": "start_time",
      "scope": {
        "location": "Lahr/Schwarzwald"
      },
      "sense": ">=",
      "value": 600
    }
  ],
  "note": "The service start time for Lahr/Schwarzwald must be at least 0 or at least 600 minutes; otherwise, no feasible solution exists."
}