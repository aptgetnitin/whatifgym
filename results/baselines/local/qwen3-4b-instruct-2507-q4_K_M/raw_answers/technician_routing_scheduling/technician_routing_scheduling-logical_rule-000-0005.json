{
  "version": "0.1",
  "base_model": "technician_routing_scheduling",
  "rules": [
    {
      "name": "lahr_schwarzwald_start_time_constraint",
      "measure": "start_time",
      "scope": {
        "location": "Lahr/Schwarzwald"
      },
      "sense": ">=",
      "value": 600
    },
    {
      "name": "lahr_schwarzwald_start_time_zero",
      "measure": "start_time",
      "scope": {
        "location": "Lahr/Schwarzwald"
      },
      "sense": "==",
      "value": 0
    }
  ],
  "note": "The total service start time for location Lahr/Schwarzwald must be either zero or at least 600 minutes."
}