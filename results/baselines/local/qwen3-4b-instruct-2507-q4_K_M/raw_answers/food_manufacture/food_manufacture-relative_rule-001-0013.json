      "scope": {
        "oil": "OIL2"
      },
      "sense": "<=",
      "value": 0.9,
      "relative_to": {
        "measure": "consume",
        "scope": {
          "oil": "VEG2"
        }
      },
      "factor": 1.0
    }
  ]
