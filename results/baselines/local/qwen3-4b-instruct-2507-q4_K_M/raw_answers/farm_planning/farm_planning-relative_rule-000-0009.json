{
  "version": "0.1",
  "base_model": "farm_planning",
  "rules": [
    {
      "name": "heifer_calf_sales_ratio",
      "measure": "sell_heifers",
      "scope": {
        "year": "Year1"
      },
      "sense": "<=",
      "value": 0.25,
      "relative_to": {
        "measure": "sell_heifers",
        "scope": {
          "year": "Year5"
        }
      },
      "factor": 1.0
    }
  ],
  "note": "The rule ensures that the number of heifer calves sold in Year1 is at most 25% of the number sold in Year5."
}